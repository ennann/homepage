<script type="module" data-astro-rerun define:vars={{ coreMessage: copy.scopeStatusCore, wideMessage: copy.scopeStatusWide }}>
    window.__aiLedgerAbortController?.abort();
    const controller = new AbortController();
    window.__aiLedgerAbortController = controller;
    const signal = controller.signal;
    const root = document.querySelector("[data-ai-ledger]");

    const applyScope = (scope, updateUrl = false) => {
        if (!root || (scope !== "core" && scope !== "wide")) return;
        root.dataset.scope = scope;
        root.querySelectorAll("[data-scope-target]").forEach((link) => {
            if (link.dataset.scopeTarget === scope) link.setAttribute("aria-current", "page");
            else link.removeAttribute("aria-current");
        });

        const live = root.querySelector("[data-scope-live]");
        if (live) live.textContent = scope === "wide" ? wideMessage : coreMessage;

        if (updateUrl) {
            const url = new URL(window.location.href);
            if (scope === "core") url.searchParams.delete("scope");
            else url.searchParams.set("scope", "wide");
            history.pushState({ ...history.state, aiLedgerScope: scope }, "", url);
        }
    };

    root?.querySelectorAll("[data-scope-target]").forEach((link) => {
        link.addEventListener("click", (event) => {
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            event.preventDefault();
            applyScope(link.dataset.scopeTarget, true);
        }, { signal });
    });

    window.addEventListener("popstate", () => {
        const scope = new URL(window.location.href).searchParams.get("scope") === "wide" ? "wide" : "core";
        applyScope(scope);
    }, { signal });

    const initialScope = new URL(window.location.href).searchParams.get("scope") === "wide" ? "wide" : "core";
    applyScope(initialScope);
</script>

