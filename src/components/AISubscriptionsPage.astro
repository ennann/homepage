---
import { Icon } from "astro-icon/components";
import { getLangFromUrl } from "../i18n/utils";
import { loadSnapshot, YEARLY_PLANS } from "../lib/ai-subscriptions";
import GoogleMark from "./ai-subscriptions/GoogleMark.astro";
import SubscriptionTimeline from "./ai-subscriptions/SubscriptionTimeline.astro";

const lang = getLangFromUrl(Astro.url);
const isZh = lang === "zh";
const locale = isZh ? "zh-CN" : "en-US";

const { snapshot, buildToday, asOfDate } = loadSnapshot();
const thisYear = Number(buildToday.slice(0, 4));

const copy = isZh
    ? {
          heroTag: "AI SUBSCRIPTION LEDGER",
          titleBefore: "我为 AI ",
          titleVerb: "付费",
          titleAfter: "这四年",
          intro: "2022 年 8 月付了第一笔 Copilot，账越记越长，现在 5 个订阅同时在跑。",
          statTotal: "TO DATE",
          statYear: `IN ${thisYear}`,
          statMonthly: "MONTHLY",
          payments: "笔付款",
          active: "个订阅在跑",
          currentTitle: "正在订阅中",
          perMonth: "/ 月",
          yearly: "年付",
          renews: "续费",
          through: "服务至",
          timelineTitle: "订阅时间线",
          timelineIntro: "Copilot 一路没断，ChatGPT 从 2024 年加入，Google、Claude 陆续跟上，Kimi 试了一个月。",
          mixTitle: "按产品",
          mixIntro: "只算 AI 订阅本身，捆绑套餐没记进来。",
          yearTitle: "按年份",
          yearIntro: `${thisYear} 年还没过完，已经超过前四年的总和。`,
          ongoing: "进行中",
          fxNote: "非人民币金额按付款当月汇率折算成人民币",
          updated: "更新于",
          usage: "最近 30 天 AI 用量",
          related: "跨区订阅怎么开",
      }
    : {
          heroTag: "AI SUBSCRIPTION LEDGER",
          titleBefore: "four years of ",
          titleVerb: "paying",
          titleAfter: " for ai",
          intro: "first charge: github copilot, august 2022. five subscriptions are running now.",
          statTotal: "TO DATE",
          statYear: `IN ${thisYear}`,
          statMonthly: "MONTHLY",
          payments: "payments",
          active: "active plans",
          currentTitle: "active subscriptions",
          perMonth: "/ mo",
          yearly: "yearly",
          renews: "Renews",
          through: "Through",
          timelineTitle: "the timeline",
          timelineIntro: "copilot never stopped. chatgpt joined in 2024, google and claude followed, and kimi lasted one month.",
          mixTitle: "by product",
          mixIntro: "ai plans only, bundles not counted.",
          yearTitle: "by year",
          yearIntro: `${thisYear} is not over yet and already tops the previous four years combined.`,
          ongoing: "ongoing",
          fxNote: "non-cny amounts are converted at the month-of-payment rate",
          updated: "updated",
          usage: "ai usage, last 30 days",
          related: "how i set up cross-region plans",
      };

const planLabels: Record<string, string> = {
    "chatgpt-pro-20x": "ChatGPT Pro 20x",
    "chatgpt-plus": "ChatGPT Plus",
    "claude-max-5x": "Claude Max 5x",
    "claude-pro": "Claude Pro",
    "copilot-pro": "GitHub Copilot Pro",
    "copilot-monthly": isZh ? "GitHub Copilot 月付" : "GitHub Copilot monthly",
    "kimi-code": "Kimi Code",
    "google-ai-pro": "Google AI Pro",
};

const channelLabels: Record<string, string> = {
    "github-direct": isZh ? "GitHub 直付" : "GitHub direct",
    "openai-direct": isZh ? "OpenAI 直付" : "OpenAI direct",
    "anthropic-direct": isZh ? "Anthropic 直付" : "Anthropic direct",
    "moonshot-direct": isZh ? "月之暗面直付" : "Moonshot direct",
    "google-direct": isZh ? "Google 直付" : "Google direct",
    "apple-us": isZh ? "App Store 美区" : "App Store US",
    "apple-turkey": isZh ? "App Store 土区" : "App Store Türkiye",
    "apple-nigeria": isZh ? "App Store 尼区" : "App Store Nigeria",
};

const productMeta = {
    chatgpt: { label: "ChatGPT", icon: "simple-icons:openai" },
    claude: { label: "Claude", icon: "simple-icons:claude" },
    copilot: { label: "Copilot", icon: "simple-icons:githubcopilot" },
    google: { label: "Google", icon: "simple-icons:google" },
    kimi: { label: "Kimi", icon: "simple-icons:moonshotai" },
} as const;

const productOrder = ["chatgpt", "claude", "copilot", "google", "kimi"] as const;
const currencyOrder = ["USD", "PHP", "TRY", "NGN", "CNY"];
const currencySymbols: Record<string, string> = { USD: "US$", PHP: "₱", TRY: "₺", NGN: "₦", CNY: "¥" };
const round2 = (value: number) => Math.round((value + Number.EPSILON) * 100) / 100;
const formatNumber = (value: number, digits = 2) =>
    new Intl.NumberFormat(locale, { minimumFractionDigits: digits, maximumFractionDigits: digits }).format(value);
const formatCny = (value: number, digits = 2) => `¥${formatNumber(value, digits)}`;
const formatOriginal = (currency: string, value: number) =>
    `${currencySymbols[currency] ?? `${currency} `}${formatNumber(value, 2)}`;
const formatDate = (date: string) =>
    new Intl.DateTimeFormat(locale, {
        year: "numeric",
        month: "short",
        day: "numeric",
        timeZone: "UTC",
    }).format(new Date(`${date}T00:00:00Z`));
const formatShortDate = (date: string) =>
    date.slice(0, 4) === buildToday.slice(0, 4)
        ? new Intl.DateTimeFormat(locale, { month: "short", day: "numeric", timeZone: "UTC" }).format(
              new Date(`${date}T00:00:00Z`),
          )
        : formatDate(date);

const coreRecords = snapshot.records.filter((record) => record.scope === "core");
const lifetimeTotal = round2(coreRecords.reduce((sum, record) => sum + record.estimatedCny, 0));
const currentTotal = round2(snapshot.currentSubscriptions.reduce((sum, item) => sum + item.estimatedCny, 0));
const thisYearTotal = round2(
    coreRecords
        .filter((record) => Number(record.date.slice(0, 4)) === thisYear)
        .reduce((sum, record) => sum + record.estimatedCny, 0),
);
const activeProducts = productOrder.filter((product) =>
    snapshot.currentSubscriptions.some((sub) => sub.product === product),
);

const products = productOrder
    .map((product) => {
        const records = coreRecords.filter((record) => record.product === product);
        const value = round2(records.reduce((sum, record) => sum + record.estimatedCny, 0));
        return {
            product,
            count: records.length,
            value,
            share: lifetimeTotal ? (value / lifetimeTotal) * 100 : 0,
        };
    })
    .filter((item) => item.count > 0)
    .sort((a, b) => b.value - a.value);

const yearTotals = [2022, 2023, 2024, 2025, 2026].map((year) => {
    const records = coreRecords.filter((record) => Number(record.date.slice(0, 4)) === year);
    return {
        year,
        count: records.length,
        value: round2(records.reduce((sum, record) => sum + record.estimatedCny, 0)),
    };
});
const maxYearTotal = Math.max(...yearTotals.map((year) => year.value), 1);

const originals = currencyOrder
    .map((currency) => ({
        currency,
        value: coreRecords
            .filter((record) => record.currency === currency)
            .reduce((sum, record) => sum + record.originalAmount, 0),
    }))
    .filter((item) => item.value > 0);

// 月度支出刻度带:2022-08 至今按付款月聚合,柱内按币种堆叠;平方根缩放保住早期月份的可读性
interface MeterMonth {
    key: string;
    total: number;
    byCurrency: { currency: string; cny: number; original: number }[];
}
const meterMonths: MeterMonth[] = [];
{
    const cursor = new Date(Date.UTC(2022, 7, 1));
    const end = new Date(`${asOfDate.slice(0, 7)}-01T00:00:00Z`);
    while (cursor <= end) {
        const key = cursor.toISOString().slice(0, 7);
        const records = coreRecords.filter((record) => record.date.startsWith(key));
        meterMonths.push({
            key,
            total: round2(records.reduce((sum, record) => sum + record.estimatedCny, 0)),
            byCurrency: currencyOrder
                .map((currency) => {
                    const matching = records.filter((record) => record.currency === currency);
                    return {
                        currency,
                        cny: round2(matching.reduce((sum, record) => sum + record.estimatedCny, 0)),
                        original: round2(matching.reduce((sum, record) => sum + record.originalAmount, 0)),
                    };
                })
                .filter((item) => item.cny > 0),
        });
        cursor.setUTCMonth(cursor.getUTCMonth() + 1);
    }
}
const maxMeterMonth = Math.max(...meterMonths.map((month) => month.total), 1);
const meterHeight = (month: MeterMonth) =>
    month.total > 0 ? Math.max(14, Math.sqrt(month.total / maxMeterMonth) * 100) : 0;
const meterTipLines = (month: MeterMonth) =>
    month.byCurrency
        .map((item) =>
            item.currency === "CNY"
                ? `CNY ${formatOriginal("CNY", item.original)}`
                : `${item.currency} ${formatOriginal(item.currency, item.original)} ≈ ${formatCny(item.cny)}`,
        )
        .join("\n");

const heroTotalRounded = Math.round(lifetimeTotal);
const updatedLabel = formatDate(asOfDate);
const relatedUrl = isZh ? "/zh/blog/202603/app-store-ai-subscription" : "/blog/202603/app-store-ai-subscription";
---

<article class="ai-ledger">
    <header class="hero">
        <p class="eyebrow"><i class="sq" aria-hidden="true"></i>{copy.heroTag} · 2022—{thisYear}</p>
        <h1>{copy.titleBefore}<em>{copy.titleVerb}</em>{copy.titleAfter}</h1>
        <p class="hero-intro">{copy.intro}</p>

        <ul class="stack-chips" aria-label={isZh ? "在用的 AI 产品" : "ai products in use"}>
            {activeProducts.map((product) => (
                <li class={`chip chip-${product}`}>
                    {product === "google" ? <GoogleMark /> : <Icon name={productMeta[product].icon} aria-hidden="true" />}
                    {productMeta[product].label}
                </li>
            ))}
        </ul>

        <dl class="stat-row">
            <div>
                <dt>{copy.statTotal}</dt>
                <dd data-countup={heroTotalRounded}>
                    <span class="stat-currency">¥</span><span class="ledger-digits">{formatNumber(heroTotalRounded, 0)}</span>
                </dd>
            </div>
            <div>
                <dt>{copy.statYear}</dt>
                <dd><span class="stat-currency">¥</span>{formatNumber(Math.round(thisYearTotal), 0)}</dd>
            </div>
            <div>
                <dt>{copy.statMonthly}</dt>
                <dd><span class="stat-currency">≈ ¥</span>{formatNumber(Math.round(currentTotal), 0)}</dd>
            </div>
        </dl>

        <p class="fx-line" aria-label={isZh ? "原币累计" : "original-currency totals"}>
            {originals.map((item, index) => (
                <span>{index > 0 && " · "}<b>{item.currency}</b> {formatOriginal(item.currency, item.value)}</span>
            ))}
        </p>
    </header>

    <aside class="meter" aria-label={isZh ? "月度支出刻度" : "monthly spend readout"}>
        <span class="meter-label">PAYMENTS · {coreRecords.length}</span>
        <span class="meter-bars">
            {meterMonths.map((month) => (
                <span
                    class="m-col"
                    data-tip-title={`${month.key.replace("-", ".")} · ${month.total > 0 ? formatCny(month.total, 0) : "¥0"}`}
                    data-tip-lines={meterTipLines(month)}
                >
                    {month.total > 0 ? (
                        <i class="m-stack" style={`height:${meterHeight(month).toFixed(1)}%`}>
                            {month.byCurrency.map((item) => (
                                <b class={`cur-${item.currency}`} style={`flex-grow:${item.cny}`}></b>
                            ))}
                        </i>
                    ) : (
                        <i class="m-empty"></i>
                    )}
                </span>
            ))}
        </span>
        <div class="meter-tip" role="tooltip" hidden>
            <b class="meter-tip-title"></b>
            <pre class="meter-tip-lines"></pre>
        </div>
    </aside>

    <section class="block" aria-labelledby="current-title">
        <p class="eyebrow"><i class="sq" aria-hidden="true"></i>01 · RUNNING</p>
        <h2 id="current-title">{copy.currentTitle}</h2>
        <p class="block-meta">≈ {formatCny(Math.round(currentTotal), 0)} {copy.perMonth} · {snapshot.currentSubscriptions.length} {copy.active}</p>

        <ol class="plan-rows">
            {snapshot.currentSubscriptions.map((sub) => (
                <li class={`plan-row tint-${sub.product}`}>
                    <span class="plan-icon">{sub.product === "google" ? <GoogleMark /> : <Icon name={productMeta[sub.product].icon} aria-hidden="true" />}</span>
                    <span class="plan-name">
                        <strong>{planLabels[sub.planKey]}</strong>
                        <small>{channelLabels[sub.channel]}{YEARLY_PLANS.has(sub.planKey) && ` · ${copy.yearly}`}</small>
                    </span>
                    <i class="plan-dots" aria-hidden="true"></i>
                    <span class="plan-price">
                        <strong>{formatOriginal(sub.currency, sub.originalAmount)}</strong>
                        {sub.currency !== "CNY" && <small>≈ {formatCny(sub.estimatedCny)}</small>}
                    </span>
                    <span class="plan-date">
                        <small>{sub.statusType === "renews" ? copy.renews : copy.through}</small>
                        <time datetime={sub.statusDate}>{formatShortDate(sub.statusDate)}</time>
                    </span>
                </li>
            ))}
        </ol>
    </section>

    <section class="block" aria-labelledby="timeline-title">
        <p class="eyebrow"><i class="sq" aria-hidden="true"></i>02 · TIMELINE</p>
        <h2 id="timeline-title">{copy.timelineTitle}</h2>
        <p class="block-intro">{copy.timelineIntro}</p>

        <div class="timeline-shell">
            <SubscriptionTimeline spans={snapshot.coverageSpans} asOf={asOfDate} isZh={isZh} />
        </div>
    </section>

    <section class="block split" aria-label={isZh ? "支出统计" : "spending stats"}>
        <div class="split-col" aria-labelledby="mix-title">
            <p class="eyebrow"><i class="sq" aria-hidden="true"></i>03 · BY PRODUCT</p>
            <h2 id="mix-title">{copy.mixTitle}</h2>
            <p class="block-intro">{copy.mixIntro}</p>

            <div class="mix-band" role="img" aria-label={products.map((item) => `${productMeta[item.product].label} ${item.share.toFixed(1)}%`).join(", ")}>
                {products.map((item) => (
                    <span class={`band-${item.product}`} style={`width:${item.share}%`}></span>
                ))}
            </div>

            <ol class="mix-rows">
                {products.map((item) => (
                    <li class={`tint-${item.product}`}>
                        <span class="plan-icon small">{item.product === "google" ? <GoogleMark /> : <Icon name={productMeta[item.product].icon} aria-hidden="true" />}</span>
                        <span class="mix-name">
                            <strong>{productMeta[item.product].label}</strong>
                            <small>{item.count} {copy.payments}</small>
                        </span>
                        <i class="plan-dots" aria-hidden="true"></i>
                        <b class="mix-value">{formatCny(item.value, 0)}</b>
                        <em class="mix-share">{item.share.toFixed(1)}%</em>
                    </li>
                ))}
            </ol>
        </div>

        <div class="split-col" aria-labelledby="year-title">
            <p class="eyebrow"><i class="sq" aria-hidden="true"></i>04 · BY YEAR</p>
            <h2 id="year-title">{copy.yearTitle}</h2>
            <p class="block-intro">{copy.yearIntro}</p>

            <div class="mix-band year-band" role="img" aria-label={yearTotals.map((item) => `${item.year} ${formatCny(item.value, 0)}`).join(", ")}>
                {yearTotals.map((item, index) => (
                    <span
                        class:list={[item.year === thisYear && "band-now"]}
                        style={`width:${(item.value / lifetimeTotal) * 100}%;--band-alpha:${0.14 + index * 0.12}`}
                    ></span>
                ))}
            </div>

            <ol class="year-rows">
                {yearTotals.map((item) => (
                    <li class:list={[item.year === thisYear && "is-now"]}>
                        <time datetime={`${item.year}`}>{item.year}</time>
                        <span class="year-bar"><i style={`width:${(item.value / maxYearTotal) * 100}%`}></i></span>
                        <b>{formatCny(item.value, 0)}</b>
                        <small>{item.year === thisYear ? copy.ongoing : `${item.count} ${copy.payments}`}</small>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <footer class="colophon">
        <p>{copy.fxNote} · {copy.updated} <time datetime={asOfDate}>{updatedLabel}</time></p>
        <nav aria-label={isZh ? "相关链接" : "related links"}>
            <a href="https://aiusage.yizhe.me" target="_blank" rel="noopener noreferrer">{copy.usage} ↗</a>
            <a href={relatedUrl}>{copy.related} →</a>
        </nav>
    </footer>
</article>

<style>
    /* Hallmark · redesign: ledger · themes: Studio (light) / Lumen Night (dark) · macrostructure: Long Document */
    /* 数据色:Observable 10 色板(d3 官方 categorical),按占比与品牌联想分配 */
    .ai-ledger {
        --ink-chatgpt: #4269d0;
        --ink-claude: #ff725c;
        --ink-copilot: #a463f2;
        --ink-google: #3ca951;
        --ink-kimi: #efb118;
        --ledger-accent: var(--brand);
        --blueprint: rgba(31, 38, 44, 0.05);
        /* 与博客详情页同款 display 栈(.font-display) */
        --font-display: "Playfair Display", Georgia, "Times New Roman", "Hiragino Sans GB", "Source Han Sans SC", "Noto Sans SC", "Noto Sans CJK SC", "PingFang SC", "Microsoft YaHei", serif;
        width: min(100% - 2.5rem, 45rem);
        margin: 0 auto;
        padding: 4rem 0 6rem;
        color: var(--text-primary);
    }

    :global(html.dark) .ai-ledger {
        --ink-chatgpt: #8aa8ec;
        --ink-claude: #ff9683;
        --ink-copilot: #bd93f7;
        --ink-google: #6fc584;
        --ink-kimi: #f5c95c;
        --blueprint: rgba(237, 242, 244, 0.055);
    }

    .tint-chatgpt { --product-ink: var(--ink-chatgpt); }
    .tint-claude { --product-ink: var(--ink-claude); }
    .tint-copilot { --product-ink: var(--ink-copilot); }
    .tint-google { --product-ink: var(--ink-google); }
    .tint-kimi { --product-ink: var(--ink-kimi); }
    .chip-chatgpt { --product-ink: var(--ink-chatgpt); }
    .chip-claude { --product-ink: var(--ink-claude); }
    .chip-copilot { --product-ink: var(--ink-copilot); }
    .chip-google { --product-ink: var(--ink-google); }
    .chip-kimi { --product-ink: var(--ink-kimi); }
    .band-chatgpt { background: var(--ink-chatgpt); }
    .band-claude { background: var(--ink-claude); }
    .band-copilot { background: var(--ink-copilot); }
    .band-google { background: var(--ink-google); }
    .band-kimi { background: var(--ink-kimi); }

    /* 图标用品牌色,数据条用图表色:OpenAI/Copilot/Kimi 墨色,Claude 官方陶土,Google 四色 G */
    .ai-ledger { --brand-claude: #c96f4a; }
    :global(html.dark) .ai-ledger { --brand-claude: #e29470; }

    .tint-chatgpt,
    .chip-chatgpt,
    .tint-copilot,
    .chip-copilot,
    .tint-kimi,
    .chip-kimi { --icon-ink: var(--text-primary); }

    .tint-claude,
    .chip-claude { --icon-ink: var(--brand-claude); }

    .tint-google,
    .chip-google { --icon-ink: var(--muted-text); }

    /* ── Eyebrow:mono 标签寄存器 ── */
    .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem;
        color: var(--muted-text);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.66rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .sq {
        width: 0.5rem;
        height: 0.5rem;
        flex: none;
        background: var(--ledger-accent);
    }

    /* ── Hero:蓝图网格上的账本封面 ── */
    .hero {
        position: relative;
        padding: 3.2rem 0 2.6rem;
    }

    .hero::before {
        content: "";
        position: absolute;
        inset: 0 -3rem;
        z-index: -1;
        background:
            linear-gradient(var(--blueprint) 1px, transparent 1px) 0 0 / 44px 44px,
            linear-gradient(90deg, var(--blueprint) 1px, transparent 1px) 0 0 / 44px 44px;
        mask-image: radial-gradient(120% 100% at 22% 0%, #000 40%, transparent 92%);
        pointer-events: none;
    }

    .hero h1 {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 5vw, 3.4rem);
        font-weight: 500;
        letter-spacing: -0.025em;
        line-height: 1.12;
        text-wrap: balance;
    }

    .hero h1 em {
        position: relative;
        color: var(--ledger-accent);
        font-style: normal;
        white-space: nowrap;
    }

    .hero h1 em::after {
        content: "";
        position: absolute;
        right: 0.04em;
        bottom: 0.02em;
        left: 0.04em;
        height: 1px;
        background: var(--ledger-accent);
        transform-origin: left center;
    }

    .hero-intro {
        max-width: 36em;
        margin: 1.4rem 0 0;
        color: var(--text-secondary);
        font-size: clamp(0.95rem, 1.5vw, 1.04rem);
        line-height: 1.85;
    }

    .stack-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 1.6rem 0 0;
        padding: 0;
        list-style: none;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        padding: 0.32rem 0.78rem;
        border: 1px solid var(--border-subtle);
        border-radius: 999px;
        background: var(--panel-bg);
        color: var(--text-secondary);
        font-size: 0.78rem;
        font-weight: 600;
        box-shadow: var(--shadow-sm);
    }

    .chip :global(svg) {
        width: 0.85rem;
        height: 0.85rem;
        color: var(--icon-ink, var(--product-ink));
    }

    /* ── 三格 stat row:衬线数字 + mono 标签 + 会计双线收尾 ── */
    .stat-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 2.6rem 0 0;
        border-top: 1px solid var(--border-subtle);
        border-bottom: 3px double color-mix(in srgb, var(--text-primary) 72%, transparent);
    }

    .stat-row > div {
        min-width: 0;
        padding: 1rem 1.2rem 1.1rem 0;
    }

    .stat-row > div + div {
        padding-left: 1.2rem;
        border-left: 1px solid var(--border-subtle);
    }

    .stat-row dt {
        margin: 0 0 0.4rem;
        color: var(--muted-text);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.62rem;
