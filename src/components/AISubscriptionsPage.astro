    .colophon a:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* ── 入场:一次编排 ── */
    @media (prefers-reduced-motion: no-preference) {
        .hero > * {
            animation: rise 560ms both cubic-bezier(0.22, 1, 0.36, 1);
        }
        .hero > :nth-child(2) { animation-delay: 60ms; }
        .hero > :nth-child(3) { animation-delay: 110ms; }
        .hero > :nth-child(4) { animation-delay: 150ms; }
        .hero > :nth-child(5) { animation-delay: 190ms; }
        .hero > :nth-child(6) { animation-delay: 230ms; }
        .hero h1 em::after {
            animation: draw 360ms 760ms both cubic-bezier(0.22, 1, 0.36, 1);
        }
        .meter { animation: rise 560ms 260ms both cubic-bezier(0.22, 1, 0.36, 1); }
        @keyframes rise {
            from { opacity: 0; transform: translateY(12px); }
