</style>

<script type="module" data-astro-rerun>
    // 刻度带 Dock 式放大:鼠标正下方最大,按高斯衰减向两侧递减
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const bars of document.querySelectorAll(".meter-bars")) {
        if (bars.dataset.magWired || reducedMotion) continue;
        bars.dataset.magWired = "1";
        const cols = Array.from(bars.children);
        let centers = null;
        let lastX = null;
        let raf = 0;

        const measure = () => {
            centers = cols.map((col) => {
                const rect = col.getBoundingClientRect();
                return rect.left + rect.width / 2;
            });
        };

        const flush = () => {
            raf = 0;
            if (lastX === null || !centers) return;
            for (let i = 0; i < cols.length; i += 1) {
                const distance = Math.abs(lastX - centers[i]);
                const scale = 1 + 0.7 * Math.exp(-((distance / 22) ** 2));
                cols[i].style.setProperty("--mag", scale < 1.02 ? "1" : scale.toFixed(3));
            }
        };

        bars.addEventListener("mouseenter", measure);
        bars.addEventListener("mousemove", (event) => {
            lastX = event.clientX;
            if (!raf) raf = requestAnimationFrame(flush);
        });
        bars.addEventListener("mouseleave", () => {
            lastX = null;
            for (const col of cols) col.style.removeProperty("--mag");
        });
        window.addEventListener("resize", () => {
            centers = null;
        });
        bars.addEventListener("mouseover", () => {
            if (!centers) measure();
        });
    }

    // 刻度带悬浮卡
    for (const meter of document.querySelectorAll(".meter")) {
        const tip = meter.querySelector(".meter-tip");
        if (!tip || tip.dataset.wired) continue;
        tip.dataset.wired = "1";
        const titleEl = tip.querySelector(".meter-tip-title");
        const linesEl = tip.querySelector(".meter-tip-lines");
        let active = null;

        const show = (col) => {
            active = col;
            titleEl.textContent = col.dataset.tipTitle;
            linesEl.textContent = col.dataset.tipLines || "";
            tip.hidden = false;
            const meterRect = meter.getBoundingClientRect();
            const colRect = col.getBoundingClientRect();
            const tipRect = tip.getBoundingClientRect();
            const centerX = colRect.left - meterRect.left + colRect.width / 2;
            const left = Math.min(Math.max(centerX - tipRect.width / 2, 2), meterRect.width - tipRect.width - 2);
            tip.style.left = `${left}px`;
            tip.style.top = `${colRect.top - meterRect.top - tipRect.height - 8}px`;
            tip.classList.add("is-show");
        };

        const hide = () => {
            active = null;
            tip.classList.remove("is-show");
            tip.hidden = true;
        };

        meter.addEventListener("mouseover", (event) => {
            const col = event.target.closest(".m-col");
            if (col) show(col);
        });
        meter.addEventListener("mouseout", (event) => {
            if (event.target.closest(".m-col")) hide();
        });
        meter.addEventListener("click", (event) => {
            const col = event.target.closest(".m-col");
            if (!col) return hide();
            if (active === col) return hide();
            show(col);
        });
    }

    // 合计数字滚动到位,只跑一次
    const el = document.querySelector("[data-countup]");
    if (el && !el.dataset.done) {
        el.dataset.done = "1";
        const target = Number(el.dataset.countup);
        const digits = el.querySelector(".ledger-digits");
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (digits && !reduced && Number.isFinite(target)) {
            const locale = document.documentElement.lang === "zh" ? "zh-CN" : "en-US";
            const fmt = new Intl.NumberFormat(locale, { maximumFractionDigits: 0 });
            const duration = 780;
            const start = performance.now();
            const ease = (t) => 1 - Math.pow(1 - t, 3);
            const tick = (now) => {
                const progress = Math.min(1, (now - start) / duration);
                digits.textContent = fmt.format(Math.round(target * ease(progress)));
                if (progress < 1) requestAnimationFrame(tick);
            };
            digits.textContent = fmt.format(0);
            requestAnimationFrame(tick);
        }
    }
</script>
