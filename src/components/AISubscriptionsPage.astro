---
import { Icon } from "astro-icon/components";
import snapshotJson from "../data/ai-subscriptions.json";
import { getLangFromUrl } from "../i18n/utils";
import SpendHistoryChart from "./ai-subscriptions/SpendHistoryChart.astro";
import SubscriptionTimeline from "./ai-subscriptions/SubscriptionTimeline.astro";

type Scope = "core" | "wide";
type Product = "chatgpt" | "claude" | "copilot" | "mixed";

interface Transaction {
    date: string;
    scope: "core" | "mixed";
    product: Product;
    app: string;
    planKey: string;
    channel: string;
    currency: string;
    originalAmount: number;
    estimatedCny: number;
    servicePeriod: string | null;
    provisionalFx: boolean;
}

interface CurrentSubscription {
    product: Exclude<Product, "mixed">;
    app: string;
    planKey: string;
    channel: string;
    currency: string;
    originalAmount: number;
    estimatedCny: number;
    statusType: "through" | "renews";
    statusDate: string;
    provisionalFx: boolean;
}

interface CoverageSpan {
    product: "chatgpt" | "claude" | "copilot";
    planKey: string;
    channel: string;
    start: string;
    end: string;
    current?: boolean;
}

interface Snapshot {
    schemaVersion: number;
    asOf: string;
    integrity: {
        coreRecordCount: number;
        wideRecordCount: number;
        coreEstimatedCny: number;
        wideEstimatedCny: number;
        currentEstimatedCny: number;
        hasProvisionalFx: boolean;
    };
    currentSubscriptions: CurrentSubscription[];
    coverageSpans: CoverageSpan[];
    records: Transaction[];
}

const snapshot = snapshotJson as Snapshot;
const lang = getLangFromUrl(Astro.url);
const isZh = lang === "zh";
const locale = isZh ? "zh-CN" : "en-US";

const copy = isZh
