          methodologyEyebrow: "06 · METHOD & PRIVACY",
          methodologyTitle: "Auditable without publishing private receipts",
          coreDefinition: "Core scope: plans where ChatGPT, Claude, GitHub Copilot, or another AI service is the main purpose of purchase.",
          wideDefinition: "Broad scope: core AI plus bundles such as Microsoft 365 Family and X Premium that also contain substantial non-AI benefits.",
          fxDefinition: "CNY values are estimated transaction by transaction using the official historical rate available for the payment date. They are not actual card or gift-card funding costs.",
          privacyDefinition: "Original PDFs, invoice captures, email, address, account labels, order and receipt IDs, payment cards, and local paths remain in a private evidence archive and never enter this site.",
          provisionalDefinition: "The Claude payment on August 25, 2026 temporarily uses FRED’s then-latest August 21 observation and will be checked when the matching H.10 observation is published.",
          sources: "Sources",
          sourceList: "GitHub Payment History, OpenAI and Anthropic receipts, and purchase history from two App Store accounts",
          usageNote: "This ledger measures subscription cost, not model calls, tokens, or Copilot request volume.",
          usageLink: "View my last 30 days of AI usage",
          related: "Related: subscribing to AI services through another App Store region",
          provisional: "FX pending review",
          current: "Current",
          scopeStatusCore: "Showing core AI: 71 payments and ¥10,192.54 estimated lifetime spend.",
          scopeStatusWide: "Showing broad AI-related spend: 74 payments and ¥10,592.68 estimated lifetime spend.",
      };

const planLabels: Record<string, string> = {
    "chatgpt-pro-20x": "ChatGPT Pro 20x",
    "chatgpt-pro-20x-adjustment": isZh ? "ChatGPT Pro 20x · 调整" : "ChatGPT Pro 20x · adjustment",
    "chatgpt-plus": "ChatGPT Plus",
    "claude-max-5x": "Claude Max 5x",
    "claude-pro": "Claude Pro",
    "copilot-pro": "GitHub Copilot Pro",
    "copilot-monthly": isZh ? "GitHub Copilot 月付" : "GitHub Copilot monthly",
    "microsoft-365-family": "Microsoft 365 Family",
    "x-premium": "X Premium",
    monthly: isZh ? "月付" : "Monthly",
};

const channelLabels: Record<string, string> = {
    "github-direct": isZh ? "GitHub 直付" : "GitHub direct",
    "openai-direct": isZh ? "OpenAI 直付" : "OpenAI direct",
    "anthropic-direct": isZh ? "Anthropic 直付" : "Anthropic direct",
    "apple-turkey": isZh ? "App Store · 土耳其区" : "App Store · Türkiye",
    "apple-nigeria": isZh ? "App Store · 尼日利亚区" : "App Store · Nigeria",
};

const productMeta: Record<Product, { label: string; icon?: string; symbol: string }> = {
    chatgpt: { label: "ChatGPT", icon: "simple-icons:openai", symbol: "circle" },
    claude: { label: "Claude", icon: "simple-icons:claude", symbol: "square" },
    copilot: { label: "GitHub Copilot", icon: "simple-icons:githubcopilot", symbol: "diamond" },
    mixed: { label: isZh ? "混合 AI 权益" : "Bundled AI benefits", symbol: "stripe" },
};

const productOrder: Product[] = ["chatgpt", "claude", "copilot", "mixed"];
const currencyOrder = ["USD", "PHP", "TRY", "NGN"];
const currencySymbols: Record<string, string> = { USD: "US$", PHP: "₱", TRY: "₺", NGN: "₦" };

const formatNumber = (value: number, digits = 2) =>
    new Intl.NumberFormat(locale, {
        minimumFractionDigits: digits,
        maximumFractionDigits: digits,
    }).format(value);
const formatCny = (value: number, digits = 2) => `¥${formatNumber(value, digits)}`;
const formatOriginal = (currency: string, value: number) =>
    `${currencySymbols[currency] ?? `${currency} `}${formatNumber(value, 2)}`;
const formatDate = (date: string, compact = false) =>
    new Intl.DateTimeFormat(locale, compact
        ? { year: "numeric", month: "2-digit", day: "2-digit", timeZone: "UTC" }
        : { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" }
    ).format(new Date(`${date}T00:00:00Z`));

const parseLooseDate = (value: string) => {
    if (/^\d{4}-\d{2}-\d{2}$/.test(value)) return value;
    const parsed = new Date(`${value.replace("Sept", "Sep")} UTC`);
    return Number.isNaN(parsed.valueOf()) ? null : parsed.toISOString().slice(0, 10);
};

const formatServicePeriod = (servicePeriod: string | null) => {
    if (!servicePeriod) return null;
    if (servicePeriod.startsWith("Renews ")) {
        const date = parseLooseDate(servicePeriod.slice(7));
        return date ? `${isZh ? "续费" : "Renews"} ${formatDate(date)}` : servicePeriod;
    }
    const parts = servicePeriod.split(" - ");
    if (parts.length === 2) {
        const start = parseLooseDate(parts[0]);
        const end = parseLooseDate(parts[1]);
        if (start && end) return `${formatDate(start)} — ${formatDate(end)}`;
    }
    return servicePeriod;
};

const round2 = (value: number) => Math.round((value + Number.EPSILON) * 100) / 100;

function buildScope(scope: Scope) {
    const records = scope === "core"
        ? snapshot.records.filter((record) => record.scope === "core")
        : snapshot.records;
    const total = round2(records.reduce((sum, record) => sum + record.estimatedCny, 0));
    const products = productOrder
        .map((product) => {
            const value = round2(
                records
                    .filter((record) => record.product === product)
                    .reduce((sum, record) => sum + record.estimatedCny, 0),
            );
            return {
                product,
                value,
                share: value > 0 ? (value / total) * 100 : 0,
                count: records.filter((record) => record.product === product).length,
            };
        })
        .filter((item) => item.value > 0);
    const originals = currencyOrder
        .map((currency) => ({
            currency,
            value: records
                .filter((record) => record.currency === currency)
                .reduce((sum, record) => sum + record.originalAmount, 0),
        }))
        .filter((item) => item.value > 0);
    const years = [2022, 2023, 2024, 2025, 2026].map((year) => {
        const yearRecords = records.filter((record) => Number(record.date.slice(0, 4)) === year);
        return {
            year,
            records: yearRecords,
            count: yearRecords.length,
            total: round2(yearRecords.reduce((sum, record) => sum + record.estimatedCny, 0)),
        };
    });
    const ledgerYears = [...years].filter((year) => year.count > 0).reverse();
    const share2026 = (years.find((year) => year.year === 2026)?.total ?? 0) / total * 100;

    return { scope, records, total, products, originals, years, ledgerYears, share2026 };
}

const scopes = { core: buildScope("core"), wide: buildScope("wide") };
const updatedLabel = formatDate(snapshot.asOf);
const currentTotal = snapshot.integrity.currentEstimatedCny;
const relatedUrl = isZh
    ? "/zh/blog/202603/app-store-ai-subscription"
    : "/blog/202603/app-store-ai-subscription";
---

<article class="ai-ledger-page" data-ai-ledger data-scope="core">
    <header class="ledger-hero">
        <div class="hero-copy">
            <p class="ledger-kicker">{copy.kicker}</p>
            <h1>{copy.title}</h1>
            <p class="hero-intro">{copy.intro}</p>

            <nav class="scope-switch" aria-label={isZh ? "统计口径" : "Accounting scope"}>
                <a href="?scope=core" data-scope-target="core" aria-current="page">
                    <span>{copy.coreScope}</span>
                    <small>{copy.coreScopeHint}</small>
                </a>
                <a href="?scope=wide" data-scope-target="wide">
                    <span>{copy.wideScope}</span>
                    <small>{copy.wideScopeHint}</small>
                </a>
            </nav>
            <p class="sr-only" data-scope-live aria-live="polite">{copy.scopeStatusCore}</p>
        </div>

        <div class="hero-ledger" aria-label={copy.lifetime}>
            <p>{copy.lifetime}</p>
            <strong data-scope-view="core">{formatCny(scopes.core.total)}</strong>
            <strong data-scope-view="wide">{formatCny(scopes.wide.total)}</strong>
            <div class="hero-total-meta">
                <span data-scope-view="core">{scopes.core.records.length} {copy.records}</span>
                <span data-scope-view="wide">{scopes.wide.records.length} {copy.records}</span>
                <span>{copy.since}</span>
            </div>
            <div class="hero-stamp">
                <span>{copy.updated}</span>
                <time datetime={snapshot.asOf}>{updatedLabel}</time>
                <small>{copy.estimated}</small>
            </div>
        </div>

        {(["core", "wide"] as Scope[]).map((scope) => (
            <div class="currency-ledger" data-scope-view={scope}>
                <div class="currency-ledger-title">
                    <span>{copy.originalCurrencies}</span>
                    <small>{copy.originalNote}</small>
                </div>
                <div class="currency-ledger-values">
                    {scopes[scope].originals.map((item) => (
                        <span>
                            <b>{item.currency}</b>
                            {formatOriginal(item.currency, item.value)}
                        </span>
                    ))}
                </div>
            </div>
        ))}
    </header>

    <section class="story-section current-section" aria-labelledby="current-title">
        <div class="section-heading split-heading">
            <div>
                <p class="section-eyebrow">{copy.currentEyebrow}</p>
                <h2 id="current-title">{copy.currentTitle}</h2>
                <p>{copy.currentIntro}</p>
            </div>
            <div class="current-run-rate">
                <span>{copy.currentCycle}</span>
                <strong>{formatCny(currentTotal)}</strong>
                <small>{copy.perMonth}</small>
            </div>
        </div>

        <ol class="current-subscriptions">
            {snapshot.currentSubscriptions.map((subscription) => {
                const meta = productMeta[subscription.product];
                return (
                    <li class={`current-row product-${subscription.product}`}>
                        <div class="current-product">
                            {meta.icon && <Icon name={meta.icon} class="current-icon" aria-hidden="true" />}
                            <div>
                                <strong>{planLabels[subscription.planKey]}</strong>
                                <span>{channelLabels[subscription.channel]}</span>
                            </div>
                        </div>
                        <div class="current-status">
                            <span class="status-dot" aria-hidden="true"></span>
                            <span>
                                {subscription.statusType === "renews"
                                    ? (isZh ? "续费" : "Renews")
                                    : (isZh ? "服务至" : "Through")}
                                {" "}{formatDate(subscription.statusDate)}
                            </span>
                        </div>
                        <div class="current-price">
                            <strong>{formatOriginal(subscription.currency, subscription.originalAmount)}</strong>
                            <span>≈ {formatCny(subscription.estimatedCny)}</span>
                            {subscription.provisionalFx && <em>{copy.provisional}</em>}
                        </div>
                    </li>
                );
            })}
        </ol>
    </section>

    <section class="story-section composition-section" aria-labelledby="composition-title">
        <div class="section-heading">
            <p class="section-eyebrow">{copy.compositionEyebrow}</p>
            <h2 id="composition-title">
                <span data-scope-view="core">{copy.compositionTitleCore}</span>
                <span data-scope-view="wide">{copy.compositionTitleWide}</span>
            </h2>
            <p>{copy.compositionIntro}</p>
        </div>

        {(["core", "wide"] as Scope[]).map((scope) => (
            <div class="composition-view" data-scope-view={scope}>
                <div
                    class="composition-bar"
                    role="img"
                    aria-label={scopes[scope].products
                        .map((item) => `${productMeta[item.product].label} ${item.share.toFixed(2)}%`)
                        .join(", ")}
                >
                    {scopes[scope].products.map((item) => (
                        <span
                            class={`composition-segment segment-${item.product}`}
                            style={`width: ${item.share}%;`}
                            title={`${productMeta[item.product].label}: ${formatCny(item.value)} · ${item.share.toFixed(2)}%`}
                        >
                            {item.share >= 10 && <b>{item.share.toFixed(1)}%</b>}
                        </span>
                    ))}
                </div>

                <ol class="composition-list">
                    {scopes[scope].products.map((item, index) => {
                        const meta = productMeta[item.product];
                        return (
                            <li>
                                <span class={`product-symbol symbol-${meta.symbol}`} aria-hidden="true"></span>
                                <span class="composition-rank">0{index + 1}</span>
                                <strong>{meta.label}</strong>
                                <span>{item.count} {copy.payments}</span>
                                <b>{formatCny(item.value)}</b>
                                <em>{item.share.toFixed(2)}%</em>
                            </li>
                        );
                    })}
                </ol>
            </div>
        ))}
    </section>

    <section class="story-section spend-section" aria-labelledby="spend-title">
        <div class="section-heading split-heading">
            <div>
                <p class="section-eyebrow">{copy.spendEyebrow}</p>
                <h2 id="spend-title">{copy.spendTitle}</h2>
                <p>{copy.spendIntro}</p>
            </div>
            <strong class="year-share" data-scope-view="core">{scopes.core.share2026.toFixed(1)}%</strong>
            <strong class="year-share" data-scope-view="wide">{scopes.wide.share2026.toFixed(1)}%</strong>
        </div>

        <div class="product-key" aria-label={isZh ? "图表产品图例" : "Chart product key"}>
            {productOrder.map((product) => (
                <span class:list={[product === "mixed" && "mixed-key"]}>
                    <i class={`product-symbol symbol-${productMeta[product].symbol}`} aria-hidden="true"></i>
                    {productMeta[product].label}
                </span>
            ))}
        </div>

        {(["core", "wide"] as Scope[]).map((scope) => (
            <div class="spend-view" data-scope-view={scope}>
                <div class="chart-desktop">
                    <SpendHistoryChart records={snapshot.records} scope={scope} isZh={isZh} />
                </div>
                <div class="chart-mobile">
                    <SpendHistoryChart records={snapshot.records} scope={scope} isZh={isZh} mobile />
                </div>

                <div class="annual-strip" aria-label={copy.yearTotal}>
                    {scopes[scope].years.map((year) => (
                        <div class:list={[year.count === 0 && "is-empty"]}>
                            <span>{year.year}</span>
                            <strong>{formatCny(year.total)}</strong>
                            <small>{year.count} {copy.payments}</small>
                        </div>
                    ))}
                </div>
            </div>
        ))}
    </section>

    <section class="story-section timeline-section" aria-labelledby="timeline-title">
        <div class="section-heading">
            <p class="section-eyebrow">{copy.timelineEyebrow}</p>
            <h2 id="timeline-title">{copy.timelineTitle}</h2>
            <p>{copy.timelineIntro}</p>
        </div>

