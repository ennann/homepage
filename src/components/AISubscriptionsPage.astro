          coreScope: "Core AI",
          coreScopeHint: "Plans purchased primarily for the AI service",
          wideScope: "Including bundles",
          wideScopeHint: "Also includes Microsoft 365 and X Premium",
          currentEyebrow: "01 · ACTIVE NOW",
          currentTitle: "Four plans are currently active",
          currentIntro: "Two ChatGPT plans run in parallel, while Claude is currently billed directly as Max 5x. Estimates use the latest payment rate for each plan.",
          currentCycle: "Current cycle",
          perMonth: "approx. / month",
          compositionEyebrow: "02 · WHERE THE MONEY WENT",
          compositionTitleCore: "ChatGPT remains the largest cost; Claude is now 27.44%",
          compositionTitleWide: "Bundles account for less than 4% of broad AI-related spend",
          compositionIntro: "Length represents each product’s share of estimated CNY spend. Names, values, and percentages are directly labeled so color is never the only cue.",
          spendEyebrow: "03 · HOW SPEND GREW",
          spendTitle: "Share of lifetime spend paid in 2026",
          spendIntro: "The upper line answers “how much in total”; the lower stacked bars answer “who was paid each month.” No paid records were found for 2023.",
          cumulative: "Cumulative and monthly spend",
          yearTotal: "Annual totals",
          timelineEyebrow: "04 · HOW PLANS CHANGED",
          timelineTitle: "From one Copilot plan to four active subscriptions",
          timelineIntro: "Lanes represent actual service coverage. Solid outlines are direct billing; dashed outlines are App Store billing. Blank space means no paid coverage was found.",
          gapCopilot: "Copilot moved from GitHub direct billing to the App Store at the end of 2025, with a three-day gap.",
          gapClaude: "Claude paused for 44 days after Apple Max 5x ended, then resumed with Anthropic direct billing.",
