          ledgerIntro: "Expand by payment year. Public data keeps only date, product, plan, channel, original amount, CNY estimate, and service period.",
          date: "Date",
          productPlan: "Product / plan",
          channel: "Channel",
          original: "Original",
          cny: "Est. CNY",
          service: "Service period",
