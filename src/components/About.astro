---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const aboutUrl = lang === "zh" ? "/zh/about" : "/about";
const moreLabel = lang === "zh" ? "阅读完整介绍 →" : "Read full intro →";
---

<section id="about" class="py-16 px-4 max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-center dark:text-white">{t("about.title")}</h2>
    <div class="border-y border-[var(--border-subtle)] py-8">
        <p class="text-lg text-[var(--muted-text)] mb-4 leading-relaxed">
            {t("about.desc")}
        </p>
        <p class="text-lg text-[var(--text-secondary)] leading-relaxed">
            {t("about.philosophy")}
        </p>
        <a href={aboutUrl} class="mt-6 inline-block text-sm font-medium text-[var(--accent-hover)] no-underline transition-colors hover:text-[var(--brand)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--page-bg)]">
            {moreLabel}
        </a>
    </div>
</section>
