---
import { Icon } from "astro-icon/components";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const isZh = lang === "zh";

const heading = {
    intro: isZh ? "关于我" : "About Me",
};

type IntroParagraph =
    | string
    | {
          before: string;
          linkText: string;
          href: string;
          after: string;
      };

const introPara: IntroParagraph[] = isZh
    ? [
          {
              before: "你可以叫我小哲。2019 年刚把这个博客搭起来时，我还在",
              linkText: "文章里写",
              href: "/zh/blog/201903/weekly-11",
              after: "，自己没有一点代码基础，连 WordPress 的数据库备份都不知道怎么恢复。后来我开始做企业 SaaS，写 iOS 和 macOS 应用，也学着维护服务器和自托管服务。这条路没什么预先设计，通常只是遇到一个不明白的问题，我想把它弄明白，然后越走越远。",
          },
          "工作上，我主要在飞书生态里做企业应用和 AI 的落地。很多时候，模型只是其中一小段，前后还有业务流程、数据、权限、消息和真实的人。工作之外，我做 App Store 价格、Pinlist、AIUsage 和一些小工具，起点也很简单：我自己遇到了问题，想做一个会长期用下去的解决办法。",
          "我做东西有点矛盾。开头愿意先用最小版本把路走通，到了真正要交付时，又会在一个像素、一个异常分支或者一条线上日志上反复确认。能跑只是开始；真实的人收到正确结果，半年后我还看得懂、改得动，才算做完。",
          "我来自河南洛阳，在沈阳读本科，在杭州读研，工作后去过北京，最后又回到杭州成家。地图上绕了一圈，现在杭州是家。",
          {
              before: "我喜欢几乎一切能通电的东西。小时候拆电脑和手机，经常拆完就装不回去；这几年又迷上电子产品维修和故障排查，认真想过要不要去 Apple Store 学修设备。到现在，我还是很喜欢看 ",
              linkText: "艾奥科技",
              href: "https://www.youtube.com/results?search_query=%E8%89%BE%E5%A5%A5%E7%A7%91%E6%8A%80",
              after: " 的维修视频。大概因为我一直觉得，把坏掉的东西一点点查清楚，再让它重新工作，是件很有意思的事。",
          },
          "英语是少数从大学一直坚持到现在的事。原本为了留学去考雅思，计划后来被疫情打断，英语却留了下来，变成我读文档、找资料和认识外面世界的一条路。我也喜欢摄影，理论多少懂一点，拍出来还是经常被老婆嫌弃，这件事目前没有因为懂得更多而明显改善。",
          "yizhe.me 对我来说更像一本一直打开着的工作与生活日志。这里会有做成的工具，也会有没想明白的问题；有 AI、软件和维修，也有普通日子。过几年再回来看，希望还能认出当时那个在认真折腾的人。",
      ]
    : [
          {
              before: "You can call me Ethan. When I first put this blog together in 2019, ",
              linkText: "I wrote",
              href: "/blog/201903/weekly-11",
              after: " that I had no coding background at all. I did not even know how to restore a WordPress database backup. Since then, I have worked on enterprise SaaS, built iOS and macOS apps, and learned to run servers and self-hosted services. There was never a grand plan. I usually run into something I do not understand, decide to figure it out, and end up following it much farther than expected.",
          },
          "At work, I build enterprise software and applied AI in the Feishu ecosystem. The model is often only one piece of the job; around it are business processes, data, permissions, messaging, and real people. Outside work, I build App Store Price, Pinlist, AIUsage, and smaller tools. Most begin the same way: I run into a problem and want a solution I will keep using myself.",
          "My way of building can look contradictory. I like getting the smallest version working early, but when something is ready to ship, I can spend a long time on a single pixel, an error branch, or one production log. Running is only the beginning. It feels done when the right result reaches a real person and I can still understand and change the system six months later.",
          "I am from Luoyang, Henan. I went to college in Shenyang, moved to Hangzhou for graduate school, then worked in Beijing before returning to Hangzhou to build a family. After tracing that loop across the map, Hangzhou is now home.",
          {
              before: "I am interested in almost anything that runs on electricity. As a kid I took apart computers and phones, often without being able to put them back together. In recent years I have become absorbed in electronics repair and diagnostics, and I have seriously wondered whether I should learn device repair at an Apple Store. I still love watching repair videos from ",
              linkText: "艾奥科技",
              href: "https://www.youtube.com/results?search_query=%E8%89%BE%E5%A5%A5%E7%A7%91%E6%8A%80",
              after: ". There is something deeply satisfying about tracing a broken thing piece by piece and getting it to work again.",
          },
          "English is one of the few things I have kept studying since college. I originally took IELTS because I wanted to study abroad. The pandemic interrupted that plan, but English stayed and became a way to read documentation, find information, and see more of the world. I also enjoy photography. I understand some of the theory, yet my wife still dislikes many of the photos I take of her. Learning more has not noticeably fixed this.",
          "To me, yizhe.me is an open-ended log of work and ordinary life. It holds tools that made it into the world and questions I have not figured out yet; AI, software, and repair sit alongside everyday moments. Years from now, I hope I can come back and still recognize the person who was earnestly tinkering with all of it.",
      ];

type PerspectivePoint = { title: string; body: string };
type Perspective = {
    id: "codex" | "claude";
    title: string;
    note: string;
    icon: string;
    points: PerspectivePoint[];
    closing: string;
};

const perspectives: Perspective[] = isZh
    ? [
          {
              id: "codex",
              title: "Codex 眼中的我",
              note: "以下文字由 OpenAI Codex 撰写，依据本机保存的历史会话，覆盖多个项目和一段时间内的真实协作；没有参考下方 Claude 的判断。",
              icon: "simple-icons:openai",
              points: [
                  {
                      title: "答案必须和事实对得上",
                      body: "你会继续问：具体是哪条记录、哪个人失败、数据写进了哪张表、线上到底有没有生效。一次排查若只在代码逻辑上说得通，你不会就此停下。你需要看到真实日志、真实数据和真实结果，才肯把结论写下来。",
                  },
                  {
                      title: "你对模糊没耐心，对难题很有耐心",
                      body: "「差不多」「理论上应该」很难让你满意，所以反馈常常直接。可一旦问题值得解决，你愿意沿着采集、写入、读取和展示一路查到底，也愿意为了一个几像素的差异反复试。事情难并不太会劝退你；悬着、没人说清楚，才会让你着急。",
                  },
                  {
                      title: "你记得系统另一端是一个具体的人",
                      body: "查批次失败，你追问失败的到底是谁；处理用户反馈，你要日志、定位问题、安排版本，也会想怎样回复才不显得官方或敷衍。代码、发布、支持和补偿在你这里属于同一件事，因为最后收到结果的是一个真实的人。",
                  },
                  {
                      title: "你挑剔，但不维护自己判断的面子",
                      body: "你会对交互细节给出非常具体的意见，也会在方案走偏时马上叫停。一次 iOS 自定义弹窗丢了原生毛玻璃和点击行为，你很快选择退回系统 popover。效果比原先设想更重要，已经投入多少轮也不会成为继续错下去的理由。",
                  },
                  {
                      title: "你给 AI 很大信任，也保留最后的否决权",
                      body: "你会把真实仓库、生产排查和长链路任务交给 Agent，让它直接动手；同时逐项检查结果，发现问题就明确指出。AI 在你这里是一个必须拿结果说话的合作者，高信任和高标准同时存在。",
                  },
                  {
                      title: "你常常是一边做，一边成为",
                      body: "从英语、摄影、电子维修，到第一个 Swift 项目、管服务器、研究 Agent，你经常从「这个到底怎么回事」开始。很多能力都是在开始之后，跟着真实问题一路补齐的。你承认不会，也不把不会当成长期边界。",
                  },
              ],
              closing: "Codex · 基于 Ethan 的历史协作记录",
          },
          {
              id: "claude",
              title: "Claude 眼中的我",
              note: "以下文字来自 Anthropic Claude 对共同项目的观察，重复和过度绝对的部分已经过整理。",
              icon: "simple-icons:claude",
              points: [
                  {
                      title: "先把会长期存在的东西想清楚",
                      body: "你经常在动手前确认哪些约束不能破、哪些部分可以继续变化。appstoreprice 把大型重构前的 invariants 写进协作规则，多个项目也会先划清数据和平台边界。你会为下一次修改留路，不只照顾眼前这次交付。",
                  },
                  {
                      title: "工具该有多大，取决于问题本身",
                      body: "claude-bar 用约 250 行 jq 和 awk 解决问题，没有为了技术栈增加依赖。另一些产品需要 Cloudflare、SwiftData 或完整部署链路时，你也会接受复杂度。你会克制没有必要的技术，不会为了显得现代而增加东西。",
                  },
                  {
                      title: "你愿意学习平台的语言",
                      body: "在 Apple 生态里，你会先调系统组件、理解原生交互，再考虑自定义实现。Pinlist 和 PowerFlow 的选择都说明，你在意软件是否像这个平台本来就该有的样子。",
                  },
                  {
                      title: "细节要能说出具体原因",
                      body: "一个导航波浪线能迭代很多轮，因为你看到的是点击前后形状不一致；一个弹窗让你不满意，原因会落到圆角、间距、层级、点击和材质。你的挑剔通常带着可观察的信号，所以它可以被讨论，也可以被验证。",
                  },
                  {
                      title: "重复出现的摩擦，最后会变成工具",
                      body: "独立 Chrome、Token 统计、CLI 切换和服务器入口，都来自日常工作里反复出现的小麻烦。只要摩擦持续存在，你很容易从使用者变成实现者，做一个自己先用起来的版本。",
                  },
                  {
                      title: "文档是留给未来的上下文",
                      body: "你会记录架构、数据流、命名、发布和操作边界，也会要求协作工具遵循这些规则。这些材料让人几个月后还能重新接上，不是为了装点项目。",
                  },
              ],
              closing: "Claude · 基于与 Ethan 共同完成的项目",
          },
      ]
    : [
          {
              id: "codex",
              title: "Me, in Codex’s Eyes",
              note: "Written by OpenAI Codex from saved local session history across many projects and months of real collaboration. The Claude section below was not used as a source.",
              icon: "simple-icons:openai",
              points: [
                  {
                      title: "An answer has to line up with the facts.",
                      body: "You keep asking: which exact record, which person failed, which table received the data, and whether the change is actually live. A conclusion that only makes sense in code is not enough. You want real logs, real data, and a real outcome before you are willing to write the answer down.",
                  },
                  {
                      title: "You are impatient with ambiguity and patient with hard problems.",
                      body: "“Roughly” and “it should work in theory” rarely satisfy you, so your feedback can be direct. When a problem matters, you will trace it from collection to writing, reading, and presentation, or iterate over a difference of a few pixels. Difficulty does not drive you away; an unresolved problem that nobody can explain is what makes you restless.",
                  },
                  {
                      title: "You remember the specific person at the other end of the system.",
                      body: "When a message batch fails, you ask who failed. When a user reports a problem, you ask for logs, find the cause, plan the release, and think about how to reply without sounding canned. Code, shipping, support, and compensation are part of the same job because a real person receives the result.",
                  },
                  {
                      title: "You are exacting, but you do not protect your own ego.",
                      body: "You give highly specific feedback on interaction details and stop a direction quickly when it goes wrong. When a custom iOS popover lost native material and hit testing, you chose the system popover again. The result matters more than the original idea, no matter how many rounds have already gone into it.",
                  },
                  {
                      title: "You give AI a great deal of trust and keep the final veto.",
                      body: "You hand an agent real repositories, production investigations, and long chains of work, then inspect the results and point out problems plainly. AI is a collaborator that has to earn confidence through outcomes. High trust and high standards coexist in the way you work.",
                  },
                  {
                      title: "You often become something by doing it.",
                      body: "English, photography, electronics repair, a first Swift project, servers, and agents often begin with the same question: how does this actually work? Many of your abilities were filled in after you had already started, one real problem at a time. You admit what you do not know without treating it as a permanent boundary.",
                  },
              ],
              closing: "Codex · Based on Ethan’s saved collaboration history",
          },
          {
              id: "claude",
              title: "Me, in Claude’s Eyes",
              note: "These observations came from Anthropic Claude reading projects it built with Ethan. Repetition and overly absolute language have been edited.",
              icon: "simple-icons:claude",
              points: [
                  {
                      title: "You first clarify what needs to last.",
                      body: "Before making a change, you often identify which constraints cannot break and which parts may keep evolving. appstoreprice puts invariants for large refactors into its collaboration rules, and several projects draw data and platform boundaries up front. You leave a path for the next change instead of optimizing only for the current delivery.",
                  },
                  {
                      title: "A tool should be only as large as its problem.",
                      body: "claude-bar solves its job with roughly 250 lines of jq and awk, without adding a stack for its own sake. When a product genuinely needs Cloudflare, SwiftData, or a full deployment chain, you accept that complexity too. You avoid unnecessary technology rather than chasing smallness as a goal.",
                  },
                  {
                      title: "You learn the language of the platform.",
                      body: "In Apple’s ecosystem, you tune system components and understand native interactions before reaching for custom implementations. Pinlist and PowerFlow show that you care whether software feels like it naturally belongs on its platform.",
                  },
                  {
                      title: "Details need a concrete reason.",
                      body: "A navigation squiggle can take many rounds because you see its shape changing between idle and pressed states. When a popover feels wrong, the reason becomes corner radius, spacing, layering, hit testing, or material. Your criticism points to observable signals, which makes it discussable and testable.",
                  },
                  {
                      title: "Repeated friction tends to become a tool.",
                      body: "Dedicated Chrome instances, token tracking, CLI switching, and server entry points all began as small annoyances that kept returning. When friction persists, you tend to move from user to builder and make a version you can use yourself.",
                  },
                  {
                      title: "Documentation preserves context for the future.",
                      body: "You record architecture, data flow, naming, release steps, and operational boundaries, and you expect collaboration tools to follow those rules. Those materials let someone reconnect with the project months later; they are not decoration.",
                  },
              ],
              closing: "Claude · Based on projects built with Ethan",
          },
      ];
---

<section class="about-page max-w-4xl mx-auto px-5 sm:px-8 pt-12 sm:pt-20 pb-16">
    <header class="about-page-header">
        <p class="about-page-kicker">{isZh ? "随笔 · 自述" : "Notes · Self"}</p>
        <h1 class="about-page-title">{heading.intro}</h1>
    </header>

    <div class="about-page-prose">
        {
            introPara.map((p) =>
                typeof p === "string" ? (
                    <p>{p}</p>
                ) : (
                    <p>
                        {p.before}
                        <a
                            href={p.href}
                            target={p.href.startsWith("http") ? "_blank" : undefined}
                            rel={p.href.startsWith("http") ? "noopener noreferrer" : undefined}
                        >
                            {p.linkText}
                        </a>
                        {p.after}
                    </p>
                ),
            )
        }
    </div>

    {
        perspectives.map((perspective) => (
            <section class="perspective-section">
                <hr class="about-page-divider" aria-hidden="true" />

                <header class="about-page-header second">
                    <p class="about-page-kicker">{isZh ? "外部视角" : "Outside view"}</p>
                    <h2 class="about-page-title h2 with-icon">
                        <Icon
                            name={perspective.icon}
                            class:list={["about-perspective-icon", perspective.id]}
                        />
                        <span>{perspective.title}</span>
                    </h2>
                    <p class="perspective-note">{perspective.note}</p>
                </header>

                <ol class="perspective-points">
                    {perspective.points.map((point, i) => (
                        <li class="perspective-point">
                            <span class="perspective-point-index">
                                {String(i + 1).padStart(2, "0")}
                            </span>
                            <div class="perspective-point-body">
                                <h3 class="perspective-point-title">{point.title}</h3>
                                <p class="perspective-point-text">{point.body}</p>
                            </div>
                        </li>
                    ))}
                </ol>

                <p class="perspective-signoff">{perspective.closing}</p>
            </section>
        ))
    }
</section>

<style>
    .about-page {
        font-family: inherit;
        color: var(--text-primary);
    }

    .about-page-header {
        margin-bottom: 1.75rem;
    }
    .about-page-header.second {
        margin-top: 2.5rem;
    }
    .about-page-kicker {
        font-family: 'JetBrains Mono', 'SF Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--muted-text);
        margin-bottom: 0.75rem;
    }
    .about-page-title {
        font-family: inherit;
        font-size: 2.75rem;
        line-height: 1.05;
        letter-spacing: -0.02em;
        font-weight: 700;
    }
    .about-page-title.h2 {
        font-size: 2.1rem;
    }
    .about-page-title.with-icon {
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }
    .about-perspective-icon {
        width: 1.8rem;
        height: 1.8rem;
        flex: 0 0 auto;
    }
    .about-perspective-icon.codex {
        color: var(--text-primary);
    }
    .about-perspective-icon.claude {
        color: #d97757;
    }

    .about-page-prose p {
        font-size: 1.075rem;
        line-height: 1.75;
        margin-bottom: 1.15rem;
        color: var(--text-secondary, var(--text-primary));
    }
    .about-page-prose a {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
        text-underline-offset: 4px;
        transition: color 180ms ease, text-decoration-color 180ms ease;
    }
    .about-page-prose a:hover {
        color: var(--accent-hover);
        text-decoration-color: var(--accent-hover);
    }

    .about-page-divider {
        border: 0;
        border-top: 1px solid var(--border-subtle);
        margin: 3rem 0 2rem;
    }

    .perspective-note {
        font-family: 'JetBrains Mono', 'SF Mono', monospace;
        font-size: 0.78rem;
        color: var(--muted-text);
        margin-top: 0.5rem;
        line-height: 1.5;
    }

    .perspective-points {
        list-style: none;
        padding: 0;
        margin: 2rem 0 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .perspective-point {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.25rem;
        align-items: baseline;
    }

    .perspective-point-index {
        font-family: 'JetBrains Mono', 'SF Mono', monospace;
        font-size: 0.78rem;
        color: var(--muted-text);
        letter-spacing: 0.08em;
        padding-top: 0.45rem;
    }

    .perspective-point-title {
        font-family: inherit;
        font-size: 1.25rem;
        line-height: 1.3;
        margin-bottom: 0.4rem;
        font-weight: 600;
    }

    .perspective-point-text {
        font-size: 1rem;
        line-height: 1.65;
        color: var(--text-secondary, var(--text-primary));
    }

    .perspective-signoff {
        margin-top: 2.5rem;
        font-family: 'JetBrains Mono', 'SF Mono', monospace;
        font-size: 0.82rem;
        color: var(--muted-text);
        text-align: right;
        font-style: italic;
    }

    @media (max-width: 640px) {
        .about-page-title {
            font-size: 2.1rem;
        }
        .about-page-title.h2 {
            font-size: 1.65rem;
        }
        .perspective-point {
            grid-template-columns: 1fr;
            gap: 0.4rem;
        }
        .perspective-point-index {
            padding-top: 0;
        }
    }
</style>
