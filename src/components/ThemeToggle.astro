---

---

<button
    id="theme-toggle"
    type="button"
    class="p-2.5 rounded-full bg-[var(--panel-subtle)] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[var(--accent)] focus:ring-offset-2 focus:ring-offset-[var(--page-bg)] cursor-pointer"
    aria-label="Toggle Dark Mode"
>
    <!-- Sun Icon (shown in dark mode) -->
    <svg id="theme-toggle-light-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path
            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
    </svg>
    <!-- Moon Icon (shown in light mode) -->
    <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
    </svg>
</button>

<script type="module" data-astro-rerun>
    const themeToggleBtn = document.getElementById("theme-toggle");
    const themeToggleDarkIcon = document.getElementById("theme-toggle-dark-icon");
    const themeToggleLightIcon = document.getElementById("theme-toggle-light-icon");

    const readDarkPreference = () => {
        try {
            const storedTheme = localStorage.getItem("color-theme");
            if (storedTheme === "dark" || storedTheme === "light") {
                return storedTheme === "dark";
            }
        } catch {
            // Fall back to the system preference when storage is unavailable.
        }

        return window.matchMedia("(prefers-color-scheme: dark)").matches;
    };

    const isDark = () => document.documentElement.classList.contains("dark");

    const applyTheme = (toDark, persist = true) => {
        document.documentElement.classList.toggle("dark", toDark);
        themeToggleDarkIcon?.classList.toggle("hidden", toDark);
        themeToggleLightIcon?.classList.toggle("hidden", !toDark);

        const themeMeta = document.querySelector('meta[name="theme-color"]');
        const themeColor = themeMeta?.getAttribute(toDark ? "data-dark" : "data-light");
        if (themeColor) themeMeta.setAttribute("content", themeColor);

        if (persist) {
            try {
                localStorage.setItem("color-theme", toDark ? "dark" : "light");
            } catch {
                // The current page still changes theme even if storage is blocked.
            }
        }
    };

    applyTheme(readDarkPreference(), false);

    themeToggleBtn?.addEventListener("click", (event) => {
        const targetDark = !isDark();

        // Honour reduced-motion: skip the reveal animation.
        const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        // Feature-detect View Transitions (Chromium 111+, Safari 18+).
        const supports =
            typeof document.startViewTransition === "function" && !prefersReduced;

        if (!supports) {
            applyTheme(targetDark);
            return;
        }

        // Origin of the circular reveal — centre of the button that was clicked.
        const rect = event.currentTarget.getBoundingClientRect();
        const x = rect.left + rect.width / 2;
        const y = rect.top + rect.height / 2;
        const endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y),
        );

        document.documentElement.style.setProperty("--theme-ripple-x", `${x}px`);
        document.documentElement.style.setProperty("--theme-ripple-y", `${y}px`);
        document.documentElement.style.setProperty("--theme-ripple-r", `${endRadius}px`);
        // Direction lets the CSS animate the new theme expanding outward
        // both when going dark and going light.
        document.documentElement.setAttribute(
            "data-theme-ripple",
            targetDark ? "to-dark" : "to-light",
        );

        const transition = document.startViewTransition(() => {
            applyTheme(targetDark);
        });

        transition.finished.finally(() => {
            document.documentElement.removeAttribute("data-theme-ripple");
            document.documentElement.style.removeProperty("--theme-ripple-x");
            document.documentElement.style.removeProperty("--theme-ripple-y");
            document.documentElement.style.removeProperty("--theme-ripple-r");
        });
    });
</script>
