---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { loadSnapshot } from "../lib/ai-subscriptions";
import SubscriptionTimeline from "./ai-subscriptions/SubscriptionTimeline.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const subscriptionLedgerUrl = lang === "zh" ? "/zh/ai-subscriptions" : "/ai-subscriptions";
const { snapshot, asOfDate } = loadSnapshot();
---

<section id="toolkit" class="py-16 px-4 max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold mb-10 text-center dark:text-white">{t("toolkit.title")}</h2>

    <div class="toolkit-groups">
        <!-- AI Subscriptions -->
        <div class="toolkit-group">
            <h3 class="toolkit-label">
                {t("toolkit.aiSubs")}
                <a href={subscriptionLedgerUrl} class="toolkit-label-link">
                    {lang === "zh" ? "费用账本" : "Cost ledger"}
                </a>
            </h3>
            <a
                href={subscriptionLedgerUrl}
                class="toolkit-timeline"
                aria-label={lang === "zh" ? "AI 订阅时间线,点击查看完整账本" : "AI subscription timeline, view the full ledger"}
            >
                <SubscriptionTimeline
                    spans={snapshot.coverageSpans}
                    asOf={asOfDate}
                    isZh={lang === "zh"}
                    domainStart="2024-01-01"
                    interactive={false}
                />
                <span class="toolkit-timeline-cta">{lang === "zh" ? "查看完整账本 →" : "View the full ledger →"}</span>
            </a>
        </div>

        <!-- Daily Tools -->
        <div class="toolkit-group">
            <h3 class="toolkit-label">{t("toolkit.dailyTools")}</h3>
            <div class="toolkit-items">
                <div class="toolkit-pill">
                    <svg class="toolkit-icon icon-ghostty" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C8.13 2 5 5.13 5 9v11l2-2 2 2 2-2 2 2 2-2 2 2V9c0-3.87-3.13-7-7-7zm-2.5 8.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z" />
                    </svg>
                    <span class="toolkit-name">Ghostty</span>
                </div>
                <div class="toolkit-pill">
                    <Icon name="simple-icons:openai" class="toolkit-icon icon-codex" />
                    <span class="toolkit-name">Codex</span>
                </div>
                <div class="toolkit-pill">
                    <Icon name="simple-icons:xcode" class="toolkit-icon icon-xcode" />
                    <span class="toolkit-name">Xcode</span>
                </div>
                <div class="toolkit-pill">
                    <Icon name="simple-icons:visualstudiocode" class="toolkit-icon icon-vscode" />
                    <span class="toolkit-name">VS Code</span>
                    <span class="toolkit-tag">{t("toolkit.vscodeNote")}</span>
                </div>
                <div class="toolkit-pill is-deprecated">
                    <Icon name="simple-icons:warp" class="toolkit-icon icon-warp" />
                    <span class="toolkit-name">Warp</span>
                </div>
                <div class="toolkit-pill is-deprecated">
                    <Icon name="simple-icons:cursor" class="toolkit-icon icon-cursor" />
                    <span class="toolkit-name">Cursor</span>
                </div>
            </div>
        </div>

        <!-- Token Usage -->
        <div class="toolkit-group">
            <h3 class="toolkit-label">
                {t("toolkit.tokenUsage")}
                <a href="https://aiusage.yizhe.me" target="_blank" rel="noopener noreferrer" class="toolkit-label-link">{t("toolkit.tokenUsageLink")}</a>
            </h3>
            <div class="ai-usage-embed">
                <iframe
                    class="stats-desktop"
                    data-src="https://aiusage.yizhe.me/embed?widget=stats-row1&items=0,1,2,3&transparent=true"
                    title={t("toolkit.tokenUsage")}
                    width="100%"
                    frameborder="0"
                    scrolling="no"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
                <iframe
                    class="stats-mobile"
                    data-src="https://aiusage.yizhe.me/embed?widget=stats-row1&items=0,1&transparent=true"
                    title={t("toolkit.tokenUsage")}
                    width="100%"
                    frameborder="0"
                    scrolling="no"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
                <iframe
                    class="cost-trend"
                    data-src="https://aiusage.yizhe.me/embed?widget=cost-trend&transparent=true"
                    title={t("toolkit.tokenUsage")}
                    width="100%"
                    frameborder="0"
                    scrolling="no"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                ></iframe>
            </div>
        </div>
    </div>
</section>

<script>
    const embed = document.querySelector<HTMLElement>(".ai-usage-embed");
    const frames = Array.from(document.querySelectorAll<HTMLIFrameElement>(".ai-usage-embed iframe[data-src]"));
    let canLoadFrames = false;

    const loadFrames = () => {
        for (const frame of frames) {
            if (!frame.src && frame.dataset.src && frame.getClientRects().length > 0) {
                frame.src = frame.dataset.src;
            }
        }
    };

    if (embed && frames.length > 0) {
        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    if (!entries.some((entry) => entry.isIntersecting)) return;
                    canLoadFrames = true;
                    loadFrames();
                    observer.disconnect();
                },
                { rootMargin: "240px 0px" },
            );

            observer.observe(embed);
        } else {
            window.addEventListener(
                "load",
                () => window.setTimeout(() => {
                    canLoadFrames = true;
                    loadFrames();
                }, 1800),
                { once: true },
            );
        }

        window.addEventListener("resize", () => {
            if (canLoadFrames) loadFrames();
        });
    }

    // Auto-resize iframes via postMessage from embed
    window.addEventListener("message", (e) => {
        if (e.origin !== "https://aiusage.yizhe.me") return;
        const { widget, height } = e.data || {};
        const nextHeight = Number(height);
        if (!widget || !Number.isFinite(nextHeight) || nextHeight <= 0) return;

        const iframes = document.querySelectorAll<HTMLIFrameElement>(".ai-usage-embed iframe");
        for (const iframe of iframes) {
            if (iframe.contentWindow === e.source) {
                iframe.style.height = `${nextHeight}px`;
                break;
            }
        }
    });
</script>

<style>
    .toolkit-groups {
        display: flex;
        flex-direction: column;
        gap: 2.25rem;
    }

    .toolkit-label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted-text);
        margin-bottom: 1rem;
    }

    .toolkit-label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--border-subtle);
        order: 2;
    }

    .toolkit-items {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
    }

    /* ── Pill ── */
    .toolkit-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.55rem 1rem;
        background: var(--panel-bg);
        border: 1px solid var(--border-subtle);
        border-radius: 0.7rem;
        transition:
            transform 280ms cubic-bezier(0.22, 0.68, 0, 1.1),
            box-shadow 280ms ease,
            border-color 280ms ease;
    }

    .toolkit-pill:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.07);
        border-color: rgba(37, 99, 235, 0.18);
    }

    :global(.dark) .toolkit-pill:hover {
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
        border-color: rgba(96, 165, 250, 0.18);
    }

    /* ── Icon ── */
    .toolkit-icon {
        width: 1.2rem;
        height: 1.2rem;
        flex-shrink: 0;
    }

    .icon-claude { color: #d97757; }
    .icon-openai { color: #1a1a1a; }
    :global(.dark) .icon-openai { color: #d4d4d8; }
    .icon-gemini { color: #4285f4; }
    .icon-copilot { color: #111827; }
    :global(.dark) .icon-copilot { color: #d4d4d8; }
    .icon-kimi { color: #1a1a1a; }
    :global(.dark) .icon-kimi { color: #d4d4d8; }
    .icon-ghostty { color: #6b5b50; }
    :global(.dark) .icon-ghostty { color: #c4b5a8; }
    .icon-warp { color: #01a4ff; }
    .icon-codex { color: #1a1a1a; }
    :global(.dark) .icon-codex { color: #d4d4d8; }
    .icon-xcode { color: #147efb; }
    .icon-vscode { color: #007acc; }
    .icon-cursor { color: #555; }
    :global(.dark) .icon-cursor { color: #777; }

    /* ── Name ── */
    .toolkit-name {
        font-size: 0.85rem;
        font-weight: 550;
        color: #1e293b;
        white-space: nowrap;
    }

    :global(.dark) .toolkit-name {
        color: #e2e8f0;
    }

    /* ── Count badge (for x2) ── */
    .toolkit-count {
        font-size: 0.65rem;
        font-weight: 700;
        padding: 0.08rem 0.35rem;
        border-radius: 0.3rem;
        line-height: 1.3;
    }

    .count-claude {
        color: #d97757;
        background: rgba(217, 119, 87, 0.1);
    }

    :global(.dark) .count-claude {
        background: rgba(217, 119, 87, 0.18);
    }

    /* ── Tag (VS Code note) ── */
    .toolkit-tag {
        font-size: 0.6rem;
        font-weight: 500;
        padding: 0.12rem 0.4rem;
        border-radius: 0.25rem;
        background: var(--panel-subtle);
        color: var(--muted-text);
        white-space: nowrap;
    }

    /* ── Deprecated ── */
    .is-deprecated {
        background: color-mix(in oklab, var(--panel-subtle) 76%, transparent);
        border-color: color-mix(in oklab, var(--border-subtle) 82%, transparent);
        border-style: dashed;
        box-shadow: none;
        opacity: 1;
    }

    .is-deprecated .toolkit-icon {
        color: var(--muted-text) !important;
        filter: grayscale(1) saturate(0);
        opacity: 0.52;
    }

    .is-deprecated .toolkit-name {
        color: var(--muted-text);
        opacity: 0.72;
        text-decoration: line-through;
        text-decoration-thickness: 1.5px;
        text-decoration-color: currentColor;
    }

    :global(.dark) .is-deprecated .toolkit-name {
        color: var(--muted-text);
    }

    .is-deprecated:hover {
        transform: none;
        box-shadow: none;
        border-color: color-mix(in oklab, var(--border-subtle) 82%, transparent);
    }

    /* ── Responsive ── */
    @media (max-width: 480px) {
        .toolkit-items {
            gap: 0.5rem;
        }
        .toolkit-pill {
            padding: 0.5rem 0.8rem;
            gap: 0.45rem;
        }
        .toolkit-name {
            font-size: 0.8rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .toolkit-pill {
            transition: none !important;
        }
    }

    /* ── AI Usage Embed ── */
    .ai-usage-embed {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .ai-usage-embed iframe {
        border-radius: 0.75rem;
        display: block;
        overflow: hidden;
    }

    /* Fallback heights before postMessage auto-resize kicks in */
    .ai-usage-embed .stats-desktop,
    .ai-usage-embed .stats-mobile {
        height: 110px;
    }

    .ai-usage-embed .cost-trend {
        height: 410px;
    }

    .ai-usage-embed .stats-mobile {
        display: none;
    }

    @media (max-width: 768px) {
        .ai-usage-embed .stats-desktop {
            display: none;
        }
        .ai-usage-embed .stats-mobile {
            display: block;
        }
    }

    /* ── Subscription timeline embed ── */
    .toolkit-timeline {
        --tl-row-h: 38px;
        --tl-axis-h: 26px;
        --tl-label-w: 118px;
        position: relative;
        display: block;
        padding: 1.1rem 1.2rem 2.1rem;
        border: 1px solid var(--border-subtle);
        border-radius: 1rem;
        background: var(--panel-bg);
        box-shadow: var(--shadow-sm);
        text-decoration: none;
        color: inherit;
        transition:
            transform 280ms cubic-bezier(0.22, 0.68, 0, 1.1),
            box-shadow 280ms ease,
            border-color 280ms ease;
    }

    .toolkit-timeline:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        border-color: var(--accent);
    }

    .toolkit-timeline :global(.tl-span) { cursor: pointer; }

    .toolkit-timeline-cta {
        position: absolute;
        right: 1.2rem;
        bottom: 0.75rem;
        color: var(--muted-text);
        font-size: 0.7rem;
        font-weight: 600;
        transition: color 200ms ease;
    }

    .toolkit-timeline:hover .toolkit-timeline-cta { color: var(--accent-hover); }
    :global(.dark) .toolkit-timeline:hover .toolkit-timeline-cta { color: var(--accent); }

    @media (max-width: 640px) {
        .toolkit-timeline {
            --tl-row-h: 34px;
            --tl-label-w: 92px;
            padding: 0.9rem 0.8rem 1.9rem;
        }
    }

    /* ── Label link ── */
    .toolkit-label-link {
        font-size: 0.58rem;
        font-weight: 500;
        color: var(--muted-text);
        text-decoration: none;
        letter-spacing: 0.02em;
        text-transform: none;
        transition: color 200ms ease;
        order: 3;
        margin-left: -0.25rem;
    }

    .toolkit-label-link:hover {
        color: #64748b;
    }

    :global(.dark) .toolkit-label-link:hover {
        color: #94a3b8;
    }
</style>
