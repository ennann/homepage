---
import { Icon } from "astro-icon/components";
import GoogleMark from "./GoogleMark.astro";

interface CoverageSpan {
    product: "chatgpt" | "claude" | "copilot" | "google" | "kimi";
    planKey: string;
    channel: string;
    start: string;
    end: string;
    current?: boolean;
}

interface Props {
    spans: CoverageSpan[];
    asOf: string;
    isZh: boolean;
    /** 时间域起点,默认账本开端;首页嵌入版从 2024-01-01 起 */
    domainStart?: string;
    /** 关闭悬浮卡(首页嵌入整体作为链接时用) */
    interactive?: boolean;
}

const { spans, asOf, isZh, domainStart: domainStartProp = "2022-08-01", interactive = true } = Astro.props;
const domainStart = Date.parse(`${domainStartProp}T00:00:00Z`);
// 右缘跟着「今天」走,留约两个半月余量;服务期更长的段裁切后渐隐
const domainEnd = Date.parse(`${asOf}T00:00:00Z`) + 75 * 86400000;
const domainRange = domainEnd - domainStart;
const position = (date: string) => {
    const value = ((Date.parse(`${date}T00:00:00Z`) - domainStart) / domainRange) * 100;
    return Math.max(0, Math.min(100, value));
};

const planLabels: Record<string, string> = {
    "chatgpt-plus": "Plus",
    "chatgpt-pro-20x": "Pro 20x",
    "claude-pro": "Pro",
    "claude-max-5x": "Max 5x",
    "copilot-monthly": isZh ? "月付" : "Monthly",
    "copilot-pro": "Pro",
    "kimi-code": "Code",
    "google-ai-pro": "AI Pro",
};

const channelLabels: Record<string, string> = {
    "github-direct": isZh ? "GitHub 直付" : "GitHub direct",
    "openai-direct": isZh ? "OpenAI 直付" : "OpenAI direct",
    "anthropic-direct": isZh ? "Anthropic 直付" : "Anthropic direct",
    "moonshot-direct": isZh ? "月之暗面直付" : "Moonshot direct",
    "google-direct": isZh ? "Google 直付" : "Google direct",
    "apple-us": isZh ? "App Store 美区" : "App Store US",
    "apple-turkey": isZh ? "App Store 土区" : "App Store Türkiye",
    "apple-nigeria": isZh ? "App Store 尼区" : "App Store Nigeria",
};

const laneDefs = [
    { key: "chatgpt-plus", product: "chatgpt", name: "ChatGPT", plan: "Plus", icon: "simple-icons:openai", match: (s: CoverageSpan) => s.planKey === "chatgpt-plus" },
    { key: "chatgpt-pro", product: "chatgpt", name: "ChatGPT", plan: "Pro 20x", icon: "simple-icons:openai", match: (s: CoverageSpan) => s.planKey === "chatgpt-pro-20x" },
    { key: "claude-pro", product: "claude", name: "Claude", plan: "Pro", icon: "simple-icons:claude", match: (s: CoverageSpan) => s.planKey === "claude-pro" },
    { key: "claude-max", product: "claude", name: "Claude", plan: "Max 5x", icon: "simple-icons:claude", match: (s: CoverageSpan) => s.planKey === "claude-max-5x" },
    { key: "copilot", product: "copilot", name: "Copilot", plan: "Pro", icon: "simple-icons:githubcopilot", match: (s: CoverageSpan) => s.product === "copilot" },
    { key: "google", product: "google", name: "Google", plan: "AI Pro", icon: "simple-icons:google", match: (s: CoverageSpan) => s.product === "google" },
    { key: "kimi", product: "kimi", name: "Kimi", plan: "Code", icon: "simple-icons:moonshotai", match: (s: CoverageSpan) => s.product === "kimi" },
] as const;

const formatDate = (date: string) =>
    new Intl.DateTimeFormat(isZh ? "zh-CN" : "en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
        timeZone: "UTC",
    }).format(new Date(`${date}T00:00:00Z`));

const spanDuration = (start: string, end: string) => {
    const days = Math.round((Date.parse(`${end}T00:00:00Z`) - Date.parse(`${start}T00:00:00Z`)) / 86400000);
    if (days < 60) return isZh ? `${days} 天` : `${days} days`;
    const months = Math.round(days / 30.44);
    return isZh ? `约 ${months} 个月` : `~${months} months`;
};

const lanes = laneDefs.map((lane) => {
    const laneSpans = spans
        .filter(lane.match)
        .slice()
        .sort((a, b) => a.start.localeCompare(b.start))
        .map((span, index, list) => {
            const joinsPrev = index > 0 && list[index - 1].end === span.start;
            const joinsNext = index < list.length - 1 && list[index + 1].start === span.end;
            const clipped = Date.parse(`${span.end}T00:00:00Z`) > domainEnd;
            const clippedStart = Date.parse(`${span.start}T00:00:00Z`) < domainStart;
            const left = clippedStart ? 0 : position(span.start);
            const width = Math.max(0.5, (clipped ? 100 : position(span.end)) - left);
            const tipTitle = `${lane.name} ${planLabels[span.planKey] ?? ""}`.trim();
            const tipDates = `${formatDate(span.start)} — ${formatDate(span.end)}`;
            const tipMeta = `${channelLabels[span.channel] ?? span.channel} · ${spanDuration(span.start, span.end)}${span.current ? (isZh ? " · 在跑" : " · active") : ""}`;
            return { ...span, joinsPrev, joinsNext, clipped, clippedStart, left, width, tipTitle, tipDates, tipMeta };
        });
    return { ...lane, spans: laneSpans };
});

const endYear = new Date(domainEnd).getUTCFullYear();
const yearTicks = Array.from({ length: Math.max(0, endYear - 2022) }, (_, i) => `${2023 + i}`)
    .map((year) => ({ label: year, at: position(`${year}-01-01`) }))
    .filter((tick) => tick.at > 0.5 && tick.at < 98.5);

// Claude Pro 与 Max 5x 的真实重叠区间
const overlapStart = "2026-04-02";
const overlapEnd = "2026-04-18";
const overlapMid = position("2026-04-10");
const overlapDays = Math.round((Date.parse(overlapEnd) - Date.parse(overlapStart)) / 86400000);
const nowAt = position(asOf);

const description = isZh
    ? `时间轴从 ${formatDate(domainStartProp)} 到 ${formatDate(asOf)}。GitHub Copilot 连续在跑;ChatGPT Plus 从 2024 年 2 月开始,2026 年 6 月又叠加 Pro 20x;Google AI Pro 从 2025 年 4 月起年付;Claude Pro 与 Max 5x 在 2026 年 4 月重叠 ${overlapDays} 天;Kimi Code 只跑了 2026 年 7 月到 8 月一个周期。`
    : `The timeline runs from ${formatDate(domainStartProp)} to ${formatDate(asOf)}. GitHub Copilot runs continuously; ChatGPT Plus starts in February 2024 with Pro 20x stacked on in June 2026; Google AI Pro runs on yearly billing from April 2025; Claude Pro and Max 5x overlap for ${overlapDays} days in April 2026; Kimi Code ran for a single cycle from July to August 2026.`;
---

<figure class="sub-timeline" role="group" aria-label={isZh ? "AI 订阅时间轴" : "AI subscription timeline"}>
    <p class="sr-only">{description}</p>

    <div class="tl-grid" aria-hidden="true">
        <div class="tl-labels">
            <span class="tl-axis-gap"></span>
            {lanes.map((lane, index) => (
                <span class:list={["tl-label", `tint-${lane.product}`, [1, 3, 4, 5].includes(index) && "group-end"]}>
                    <i class="tl-label-icon">{lane.product === "google" ? <GoogleMark /> : <Icon name={lane.icon} />}</i>
                    <strong>{lane.name}</strong>
                    <small>{lane.plan}</small>
                </span>
            ))}
        </div>

        <div class="tl-plot">
            <div class="tl-axis">
                {yearTicks.map((tick) => (
                    <span class="tl-year" style={`left:${tick.at}%`}>{tick.label}</span>
                ))}
            </div>

            {lanes.map((lane, index) => (
                <div class:list={["tl-track", `tint-${lane.product}`, [1, 3, 4, 5].includes(index) && "group-end"]}>
                    {lane.spans.map((span) => (
                        <span
                            class:list={[
                                "tl-span",
                                span.current && "is-current",
                                span.joinsPrev && "joins-prev",
                                span.joinsNext && "joins-next",
                                span.clipped && "is-clipped",
                                span.clippedStart && "is-clipped-start",
                            ]}
                            style={`left:${span.left}%;width:${span.width}%`}
                            data-tip-title={span.tipTitle}
                            data-tip-dates={span.tipDates}
                            data-tip-meta={span.tipMeta}
                        ></span>
                    ))}
                </div>
            ))}

            {yearTicks.map((tick) => (
                <i class="tl-yearline" style={`left:${tick.at}%`}></i>
            ))}

            <span class="tl-overlap" style={`left:${overlapMid}%`}>
                <b>{isZh ? `重叠 · ${overlapDays} 天` : `OVERLAP · ${overlapDays}D`}</b>
                <i class="tl-overlap-leader"></i>
            </span>

            <span class="tl-now" style={`left:${nowAt}%`}>
                <b>{isZh ? "今天" : "Today"}</b>
            </span>

            {interactive && (
                <div class="tl-tip" role="tooltip" hidden>
                    <b class="tl-tip-title"></b>
                    <span class="tl-tip-dates"></span>
                    <small class="tl-tip-meta"></small>
                </div>
            )}
        </div>
    </div>
</figure>

<script type="module" data-astro-rerun>
    for (const plot of document.querySelectorAll(".tl-plot")) {
        const tip = plot.querySelector(".tl-tip");
        if (!tip || tip.dataset.wired) continue;
        tip.dataset.wired = "1";
        const titleEl = tip.querySelector(".tl-tip-title");
        const datesEl = tip.querySelector(".tl-tip-dates");
        const metaEl = tip.querySelector(".tl-tip-meta");
        let activeSpan = null;

        const show = (span) => {
            activeSpan = span;
            titleEl.textContent = span.dataset.tipTitle;
            datesEl.textContent = span.dataset.tipDates;
            metaEl.textContent = span.dataset.tipMeta;
            tip.hidden = false;
            const plotRect = plot.getBoundingClientRect();
            const spanRect = span.getBoundingClientRect();
            const tipRect = tip.getBoundingClientRect();
            const centerX = spanRect.left - plotRect.left + spanRect.width / 2;
            const left = Math.min(Math.max(centerX - tipRect.width / 2, 2), plotRect.width - tipRect.width - 2);
            let top = spanRect.top - plotRect.top - tipRect.height - 8;
            if (top < 2) top = spanRect.bottom - plotRect.top + 8;
            tip.style.left = `${left}px`;
            tip.style.top = `${top}px`;
            tip.classList.add("is-show");
        };

        const hide = () => {
            activeSpan = null;
            tip.classList.remove("is-show");
            tip.hidden = true;
        };

        plot.addEventListener("mouseover", (event) => {
            const span = event.target.closest(".tl-span");
            if (span) show(span);
        });
        plot.addEventListener("mouseout", (event) => {
            if (event.target.closest(".tl-span") && !event.relatedTarget?.closest(".tl-tip")) hide();
        });
        plot.addEventListener("click", (event) => {
            const span = event.target.closest(".tl-span");
            if (!span) return hide();
            if (activeSpan === span) return hide();
            show(span);
        });
        document.addEventListener("click", (event) => {
            if (activeSpan && !event.target.closest(".tl-plot")) hide();
        });
    }
</script>

<style>
    .sub-timeline {
        --axis-h: var(--tl-axis-h, 30px);
        --row-h: var(--tl-row-h, 46px);
        --label-w: var(--tl-label-w, 146px);
        /* 默认数据色板(Observable 10);宿主容器可覆盖 */
        --ink-chatgpt: #4269d0;
        --ink-claude: #ff725c;
        --ink-copilot: #a463f2;
        --ink-google: #3ca951;
        --ink-kimi: #efb118;
        --brand-claude: #c96f4a;
        margin: 0;
        color: var(--text-primary);
    }

    :global(html.dark) .sub-timeline {
        --ink-chatgpt: #8aa8ec;
        --ink-claude: #ff9683;
        --ink-copilot: #bd93f7;
        --ink-google: #6fc584;
        --ink-kimi: #f5c95c;
        --brand-claude: #e29470;
    }

    .tint-chatgpt { --product-ink: var(--ink-chatgpt); }
    .tint-claude { --product-ink: var(--ink-claude); }
    .tint-copilot { --product-ink: var(--ink-copilot); }
    .tint-google { --product-ink: var(--ink-google); }
    .tint-kimi { --product-ink: var(--ink-kimi); }

    /* 图标用品牌色,数据条用图表色 */
    .tl-label.tint-chatgpt .tl-label-icon,
    .tl-label.tint-copilot .tl-label-icon,
    .tl-label.tint-kimi .tl-label-icon { color: var(--text-primary); }

    .tl-label.tint-claude .tl-label-icon { color: var(--brand-claude, #c96f4a); }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    .tl-grid {
        display: grid;
        grid-template-columns: var(--label-w) minmax(0, 1fr);
        gap: 0 0.9rem;
    }

    .tl-labels,
    .tl-plot {
        display: grid;
        grid-template-rows: var(--axis-h) repeat(7, var(--row-h));
    }

    /* ── Labels:裸 logo + 厂商名 + 计划名,单行 ── */
    .tl-label {
        display: flex;
        align-items: center;
        gap: 0.42rem;
        min-width: 0;
        border-bottom: 1px solid color-mix(in srgb, var(--border-subtle) 55%, transparent);
    }

    .tl-label.group-end,
    .tl-track.group-end { border-bottom-color: var(--border-subtle); }

    .tl-label-icon {
        display: grid;
        place-items: center;
        flex: none;
        color: var(--product-ink);
    }

    .tl-label-icon :global(svg) {
        width: var(--tl-icon-size, 0.92rem);
        height: var(--tl-icon-size, 0.92rem);
    }

    .tl-label strong {
        flex: none;
        font-size: 0.73rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .tl-label small {
        overflow: hidden;
        color: var(--muted-text);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.58rem;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    /* ── Plot ── */
    .tl-plot { position: relative; }

    .tl-axis { position: relative; }

    .tl-year {
        position: absolute;
        top: 0.15rem;
        color: var(--muted-text);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.62rem;
        font-variant-numeric: tabular-nums;
        transform: translateX(-50%);
    }

    .tl-yearline {
        position: absolute;
        top: var(--axis-h);
        bottom: 4px;
        width: 1px;
        background: color-mix(in srgb, var(--border-subtle) 60%, transparent);
        pointer-events: none;
    }

    .tl-track {
        position: relative;
        border-bottom: 1px solid color-mix(in srgb, var(--border-subtle) 55%, transparent);
    }

    .tl-track:last-of-type { border-bottom: 0; }

    /* ── Spans:胶囊段 ── */
    .tl-span {
        position: absolute;
        top: 50%;
        z-index: 2;
        height: 18px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--product-ink) 24%, var(--panel-bg));
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--product-ink) 32%, transparent);
        transform: translateY(-50%);
        transition: box-shadow 150ms ease;
    }

    .tl-span:hover { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--product-ink) 65%, transparent); }
    .tl-span { cursor: pointer; }

    /* ── 悬浮卡 ── */
    .tl-tip {
        position: absolute;
        z-index: 9;
        display: grid;
        gap: 0.18rem;
        max-width: 15rem;
        padding: 0.55rem 0.75rem;
        border: 1px solid var(--border-subtle);
        border-radius: 0.6rem;
        background: var(--panel-bg);
        box-shadow: var(--shadow-md);
        opacity: 0;
        pointer-events: none;
        transition: opacity 120ms ease;
    }

    .tl-tip.is-show { opacity: 1; }
    .tl-tip-title { font-size: 0.74rem; font-weight: 700; letter-spacing: -0.01em; }
    .tl-tip-dates {
        color: var(--text-secondary);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.64rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .tl-tip-meta { color: var(--muted-text); font-size: 0.62rem; }

    .tl-span.is-current {
        background: var(--product-ink);
        box-shadow: none;
    }

    /* 相接的段连成一条,交界处一道细缝提示计划切换 */
    .tl-span.joins-next { border-start-end-radius: 0; border-end-end-radius: 0; }
    .tl-span.joins-prev {
        border-start-start-radius: 0;
        border-end-start-radius: 0;
        border-left: 2px solid var(--panel-bg);
    }

    /* 服务期超出可视范围:右端渐隐,表示还在往后延续 */
    .tl-span.is-clipped {
        border-start-end-radius: 0;
        border-end-end-radius: 0;
        mask-image: linear-gradient(to right, #000 calc(100% - 26px), transparent);
    }

    /* 开始时间早于可视范围:左端渐隐 */
    .tl-span.is-clipped-start {
        border-start-start-radius: 0;
        border-end-start-radius: 0;
        mask-image: linear-gradient(to left, #000 calc(100% - 26px), transparent);
    }

    /* ── Claude 重叠标注:图纸式 leader 线,落在两条 Claude 轨道的交界 ── */
    .tl-overlap {
        position: absolute;
        z-index: 3;
        top: calc(var(--axis-h) + var(--row-h) * 3);
        display: flex;
        gap: 0.5rem;
        align-items: center;
        pointer-events: none;
        transform: translate(-100%, -50%);
    }

    .tl-overlap b {
        color: var(--muted-text);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.58rem;
        font-weight: 500;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .tl-overlap-leader {
        position: relative;
        width: 58px;
        height: 1px;
        background: color-mix(in srgb, var(--muted-text) 55%, transparent);
    }

    .tl-overlap-leader::after {
        content: "";
        position: absolute;
        top: -4px;
        right: 0;
        width: 1px;
        height: 9px;
        background: inherit;
    }

    /* ── Now ── */
    .tl-now {
        position: absolute;
        z-index: 4;
        top: var(--axis-h);
        bottom: 4px;
        width: 1px;
        background: color-mix(in srgb, var(--text-primary) 42%, transparent);
        pointer-events: none;
    }

    .tl-now b {
        position: absolute;
        top: -1.35rem;
        left: 50%;
        padding: 0.1rem 0.42rem;
        border-radius: 999px;
        background: var(--text-primary);
        color: var(--page-bg);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.56rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        white-space: nowrap;
        transform: translateX(-50%);
    }

    /* ── Mobile ── */
    @media (max-width: 640px) {
        .sub-timeline {
            --row-h: var(--tl-row-h, 40px);
            --label-w: var(--tl-label-w, 112px);
        }

        .tl-grid { gap: 0 0.5rem; }
        .tl-label { gap: 0.32rem; }
        .tl-label-icon :global(svg) { width: 0.72rem; height: 0.72rem; }
        .tl-label strong { font-size: 0.62rem; }
        .tl-label small { font-size: 0.5rem; }
        .tl-year { font-size: 0.54rem; }
        .tl-span { height: 14px; }
        .tl-overlap b { display: none; }
        .tl-now b { font-size: 0.5rem; top: -1.25rem; }
    }
</style>
