---
import ResumeLayout from "../../resume/Layout.astro";
import cv from "../../resume/data/cv.json";

const { basics, focus, caseStudies, agentEngineering, independentProducts, work, skills, recognition, meta } = cv;
const updatedLabel = new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit"
}).format(new Date(`${meta.updatedAt}T00:00:00+08:00`));
---

<ResumeLayout title={`${basics.name}｜${basics.label}`} description={basics.summary}>
    <aside class="access-note" aria-label="访问状态">仅受邀访问</aside>

    <main class="resume" id="top">
        <header class="intro" aria-labelledby="resume-name">
            <div class="identity">
                <img
                    class="avatar"
                    src={basics.image}
                    width="88"
                    height="88"
                    alt="赵宜哲的头像"
                    decoding="async"
                    fetchpriority="high"
                />
                <div class="intro-copy">
                    <h1 id="resume-name">{basics.intro[0]}</h1>
                    <p class="intro-lead">{basics.intro[1]}</p>
                    <p>{basics.intro[2]}</p>
                </div>
            </div>

            <nav class="quick-links" aria-label="简历快捷操作">
                <a href="#about">关于我</a>
                <span aria-hidden="true">·</span>
                <a href={meta.pdfPath} download="赵宜哲-简历.pdf">下载 PDF</a>
                <span aria-hidden="true">·</span>
                <a href={`mailto:${basics.email}`}>{basics.email}</a>
                <span aria-hidden="true">·</span>
                <a href={basics.github} target="_blank" rel="noreferrer">GitHub</a>
            </nav>
        </header>

        <section class="section" id="about" aria-labelledby="focus-title">
            <p class="section-kicker">关于我</p>
            <h2 id="focus-title">我主要在做四件事</h2>
            <div class="focus-list">
                {focus.map((item) => (
                    <a class="focus-row" href={`#${item.anchor}`}>
                        <span class="focus-number">{item.number}</span>
                        <span class="focus-title">{item.title}</span>
                        <span class="focus-name">{item.name}</span>
                        <span class="focus-result">{item.result}</span>
                    </a>
                ))}
            </div>
        </section>

        <section class="section" aria-labelledby="enterprise-title">
            <p class="section-kicker">客户现场</p>
            <h2 id="enterprise-title">两个独立的消费行业项目</h2>
            <p class="section-intro">
                一个项目解决规模化协作，另一个项目解决 AI 判断与经营闭环。它们共同说明了我如何从现场问题出发，完成产品抽象并推动结果落地。
            </p>

            <div class="case-list">
                {caseStudies.map((project, index) => (
                    <article class="case-study" id={project.id}>
                        <p class="project-index">{String(index + 1).padStart(2, "0")} / {project.eyebrow}</p>
                        <h3>{project.name}</h3>
                        <p class="project-lead">{project.lead}</p>
                        <div class="story">
                            {project.story.map((part) => (
                                <p><strong>{part.label}</strong><span>{part.text}</span></p>
                            ))}
                        </div>
                        <p class="my-role"><strong>我的角色</strong>{project.role}</p>
                    </article>
                ))}
            </div>
        </section>

        <section class="section" id={agentEngineering.id} aria-labelledby="agent-title">
            <p class="section-kicker">{agentEngineering.eyebrow}</p>
            <h2 id="agent-title">{agentEngineering.name}</h2>
            <p class="section-intro">{agentEngineering.intro}</p>

            <dl class="capability-list">
                {agentEngineering.items.map((item, index) => (
                    <div class="capability-row">
                        <dt><span>{String(index + 1).padStart(2, "0")}</span>{item.name}</dt>
                        <dd>{item.text}</dd>
                    </div>
                ))}
            </dl>
            <p class="section-conclusion">{agentEngineering.conclusion}</p>
        </section>

        <section class="section" id="indie-products" aria-labelledby="products-title">
            <p class="section-kicker">自己做产品</p>
            <h2 id="products-title">从想法到真实用户</h2>
            <p class="section-intro">
                独立产品让我持续面对真实选择：什么值得做、怎样快速上线、数据说明了什么，以及一个产品如何被长期维护。
            </p>

            <div class="product-list">
                {independentProducts.map((product, index) => (
                    <article class:list={["product", index > 0 && "product-secondary"]} id={product.id}>
                        <a class="product-image-link" href={product.url} target="_blank" rel="noreferrer" aria-label={`查看 ${product.name}`}>
                            <img
                                class="product-image"
                                src={product.image}
                                width={product.imageWidth}
                                height={product.imageHeight}
                                alt={`${product.name} 产品界面`}
                                loading={index === 0 ? "eager" : "lazy"}
                                decoding="async"
                            />
                        </a>
                        <div class="product-copy">
                            <p class="project-index">{String(index + 1).padStart(2, "0")} / 独立产品</p>
                            <h3>{product.name}</h3>
                            <p class="product-label">{product.label}</p>
                            <p>{product.text}</p>
                            <p class="product-metrics">{product.metrics}</p>
                            <a class="text-link" href={product.url} target="_blank" rel="noreferrer">查看产品</a>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <section class="section" id="experience" aria-labelledby="experience-title">
            <p class="section-kicker">工作经历</p>
            <h2 id="experience-title">连接业务产品与工程</h2>

            {work.map((item) => (
                <article class="experience">
                    <div class="experience-heading">
                        <div>
                            <h3>{item.name}</h3>
                            <p>{item.position}</p>
                        </div>
                        <p class="experience-time">2021.07 - 至今</p>
                    </div>
                    <p>{item.summary}</p>
                    <ul>
                        {item.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                </article>
            ))}
        </section>

        <section class="section" id="skills" aria-labelledby="skills-title">
            <p class="section-kicker">能力结构</p>
            <h2 id="skills-title">连接现场与工程</h2>
            <div class="skills-list">
                {skills.map((group) => (
                    <div class="skill-row">
                        <h3>{group.name}</h3>
                        <p>{group.keywords.join(" · ")}</p>
                    </div>
                ))}
            </div>

            <div class="recognition">
                <p><strong>{recognition.title}</strong><span>{recognition.text}</span></p>
            </div>
        </section>

        <section class="closing" aria-labelledby="closing-title">
            <p class="section-kicker">接下来</p>
            <h2 id="closing-title">离 AI 更近</h2>
            <p>
                我也希望继续做从 0 到 1 的事情。我更关注真实问题、产品判断和落地结果。如果你的团队也在寻找能进入客户现场、理解技术边界，又愿意亲手把产品做出来的人，我们可以聊聊。
            </p>
            <a class="text-link" href={`mailto:${basics.email}`}>联系我</a>
        </section>

        <footer class="footer">
            <span>{basics.englishName}</span>
            <span>{basics.location.city}</span>
            <span>更新于 {updatedLabel}</span>
            <a href="#top">回到顶部</a>
        </footer>
    </main>
</ResumeLayout>

<style>
    .access-note {
        position: fixed;
        z-index: 10;
        top: 30px;
        right: 34px;
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0;
    }

    .resume {
        width: min(780px, calc(100% - 48px));
        margin: 0 auto;
        padding: 76px 0 48px;
    }

    .intro {
        margin-bottom: 76px;
    }

    .identity {
        display: grid;
        grid-template-columns: 88px minmax(0, 1fr);
        gap: 32px;
        align-items: start;
    }

    .avatar {
        display: block;
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: #eef1f3;
        object-fit: cover;
    }

    .intro-copy {
        max-width: 650px;
    }

    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }

    h1,
    h2,
    h3 {
        line-break: strict;
        text-wrap: balance;
    }

    h1 {
        margin-bottom: 12px;
        font-size: 22px;
        font-weight: 650;
        letter-spacing: 0;
    }

    h2 {
        margin-bottom: 14px;
        font-size: 20px;
        font-weight: 650;
        line-height: 1.45;
        letter-spacing: 0;
    }

    h3 {
        margin-bottom: 12px;
        font-size: 18px;
        font-weight: 650;
        line-height: 1.45;
        letter-spacing: 0;
    }

    p,
    li,
    dd,
    dt {
        color: var(--body);
        font-size: 16px;
        line-height: 1.85;
        line-break: strict;
        text-wrap: pretty;
        word-break: normal;
    }

    .intro-copy p {
        margin-bottom: 8px;
        font-size: 17px;
        line-height: 1.8;
    }

    .intro-copy .intro-lead {
        color: var(--ink);
        font-weight: 520;
    }

    .quick-links {
        display: flex;
        flex-wrap: wrap;
        gap: 7px 10px;
        margin: 26px 0 0 120px;
        color: var(--body);
        font-size: 14px;
    }

    .quick-links a,
    .text-link,
    .footer a {
        text-decoration-line: underline;
        text-decoration-color: #9a9b96;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
        transition: color 160ms ease, text-decoration-color 160ms ease;
    }

    .quick-links a:hover,
    .text-link:hover,
    .footer a:hover {
        color: var(--accent);
        text-decoration-color: var(--accent);
    }

    .section {
        margin-bottom: 86px;
        scroll-margin-top: 28px;
    }

    .section-kicker,
    .project-index {
        margin-bottom: 8px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        line-height: 1.5;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .section-intro {
        max-width: 700px;
        margin-bottom: 30px;
    }

    .focus-list {
        margin-top: 24px;
        border-top: 1px solid var(--hairline);
    }

    .focus-row {
        display: grid;
        grid-template-columns: 34px minmax(220px, 1.6fr) minmax(120px, 1fr) auto;
        gap: 14px;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid var(--hairline);
        color: var(--body);
        text-decoration: none;
    }

    .focus-row:hover .focus-title {
        color: var(--accent);
    }

    .focus-number,
    .focus-result {
        color: var(--muted);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
    }

    .focus-title {
        color: var(--ink);
        font-size: 14px;
        font-weight: 560;
    }

    .focus-name,
    .focus-result {
        font-size: 13px;
    }

    .case-list {
        margin-top: 36px;
    }

    .case-study {
        padding: 0 0 42px;
        scroll-margin-top: 28px;
    }

    .case-study + .case-study {
        padding-top: 42px;
        border-top: 1px solid var(--hairline);
    }

    .project-lead {
        max-width: 690px;
        margin-bottom: 22px;
        color: var(--ink);
        font-size: 16px;
        font-weight: 540;
        line-height: 1.75;
    }

    .story p {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr);
        gap: 10px;
        margin-bottom: 10px;
    }

    .story strong {
        color: var(--ink);
        font-weight: 650;
    }

    .story span {
        min-width: 0;
    }

    .my-role {
        margin: 20px 0 0;
        padding: 12px 16px;
        background: var(--soft);
        color: #6f706c;
        font-size: 13px;
        line-height: 1.65;
    }

    .my-role strong {
        margin-right: 10px;
        color: var(--body);
        font-weight: 650;
    }

    .capability-list {
        margin: 30px 0 0;
        border-top: 1px solid var(--hairline);
    }

    .capability-row {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 28px;
        padding: 20px 0;
        border-bottom: 1px solid var(--hairline);
    }

    .capability-row dt,
    .capability-row dd {
        margin: 0;
    }

    .capability-row dt {
        color: var(--ink);
        font-size: 14px;
        font-weight: 650;
    }

    .capability-row dt span {
        display: inline-block;
        width: 34px;
        color: var(--muted);
        font-size: 11px;
        font-variant-numeric: tabular-nums;
    }

    .capability-row dd {
        font-size: 14px;
        line-height: 1.75;
    }

    .section-conclusion {
        margin: 22px 0 0;
        color: var(--ink);
        font-weight: 540;
    }

    .product {
        display: grid;
        grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
        gap: 34px;
        align-items: start;
        padding: 34px 0 50px;
        scroll-margin-top: 28px;
    }

    .product + .product {
        border-top: 1px solid var(--hairline);
    }

    .product-image-link {
        display: block;
        width: 100%;
    }

    .product-image {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid #e8e6df;
        border-radius: 8px;
        background: #f2f4f5;
        object-fit: contain;
        transition: transform 220ms ease, border-color 220ms ease;
    }

    .product-image-link:hover .product-image {
        transform: translateY(-2px);
        border-color: #c9c7c0;
    }

    .product-copy {
        max-width: 720px;
    }

    .product-copy > p {
        margin-bottom: 13px;
    }

    .product-label {
        color: var(--muted);
        font-size: 13px;
    }

    .product-metrics {
        color: var(--ink);
        font-size: 13px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .text-link {
        display: inline-block;
        margin-top: 5px;
        color: var(--ink);
        font-size: 14px;
        font-weight: 560;
    }

    .experience {
        padding-top: 28px;
        border-top: 1px solid var(--hairline);
    }

    .experience-heading {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 20px;
    }

    .experience-heading h3,
    .experience-heading p {
        margin-bottom: 2px;
    }

    .experience-time {
        color: var(--muted);
        font-size: 13px;
        white-space: nowrap;
    }

    .experience ul {
        margin: 20px 0 0;
        padding: 0;
        list-style: none;
    }

    .experience li {
        position: relative;
        margin-bottom: 8px;
        padding-left: 18px;
    }

    .experience li::before {
        position: absolute;
        left: 0;
        color: var(--muted);
        content: "-";
    }

    .skills-list {
        margin-top: 28px;
        border-top: 1px solid var(--hairline);
    }

    .skill-row {
        display: grid;
        grid-template-columns: 140px minmax(0, 1fr);
        gap: 24px;
        padding: 17px 0;
        border-bottom: 1px solid var(--hairline);
    }

    .skill-row h3,
    .skill-row p {
        margin: 0;
        font-size: 14px;
        line-height: 1.75;
    }

    .skill-row h3 {
        color: var(--ink);
    }

    .recognition {
        margin-top: 28px;
        padding: 18px 0;
    }

    .recognition p {
        display: flex;
        gap: 14px;
        margin: 0;
    }

    .recognition strong {
        flex: 0 0 auto;
        color: var(--ink);
    }

    .closing {
        margin: 8px 0 90px;
        padding: 34px 0 0;
        border-top: 1px solid var(--hairline);
    }

    .closing h2 {
        max-width: 660px;
        font-size: 24px;
    }

    .closing p:not(.section-kicker) {
        max-width: 690px;
    }

    .footer {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
        align-items: center;
        padding-top: 22px;
        border-top: 1px solid var(--hairline);
        color: var(--muted);
        font-size: 12px;
    }

    .footer a {
        margin-left: auto;
    }

    @media (max-width: 720px) {
        .access-note {
            position: absolute;
            top: 20px;
            right: 20px;
        }

        .resume {
            width: min(100% - 36px, 780px);
            padding-top: 66px;
        }

        .identity {
            grid-template-columns: 64px minmax(0, 1fr);
            gap: 18px;
        }

        .avatar {
            width: 64px;
            height: 64px;
        }

        .intro-copy p {
            font-size: 16px;
        }

        .quick-links {
            margin-left: 82px;
        }

        .intro,
        .section {
            margin-bottom: 64px;
        }

        .focus-row {
            grid-template-columns: 30px minmax(0, 1fr);
            gap: 8px;
        }

        .focus-name,
        .focus-result {
            grid-column: 2;
        }

        .focus-result {
            margin-top: -5px;
        }

        .story p,
        .capability-row,
        .skill-row {
            grid-template-columns: 1fr;
            gap: 4px;
        }

        .story strong {
            font-size: 13px;
        }

        .capability-row {
            gap: 8px;
        }

        .product {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .product-image-link {
            width: min(100%, 440px);
        }

        .experience-heading {
            display: block;
        }

        .experience-time {
            margin-top: 8px;
        }

        .recognition p {
            display: block;
        }

        .recognition strong {
            display: block;
            margin-bottom: 6px;
        }

        .footer a {
            margin-left: 0;
        }
    }

    @media (max-width: 460px) {
        .resume {
            width: min(100% - 28px, 780px);
        }

        .identity {
            display: block;
        }

        .avatar {
            margin-bottom: 22px;
        }

        .quick-links {
            margin-left: 0;
        }

        h1 {
            font-size: 21px;
        }

        h2 {
            font-size: 19px;
        }

        .closing h2 {
            font-size: 22px;
        }
    }

    @media print {
        .access-note,
        .quick-links,
        .product-image-link,
        .footer a,
        .closing {
            display: none !important;
        }

        .resume {
            width: 100%;
            padding: 0;
        }

        .intro {
            margin-bottom: 12mm;
        }

        .identity {
            grid-template-columns: 19mm 1fr;
            gap: 7mm;
        }

        .avatar {
            width: 19mm;
            height: 19mm;
        }

        h1 {
            font-size: 16pt;
        }

        h2 {
            font-size: 13pt;
        }

        h3 {
            font-size: 11pt;
        }

        p,
        li,
        dd,
        dt,
        .intro-copy p {
            font-size: 9pt;
            line-height: 1.55;
        }

        .section {
            margin-bottom: 9mm;
        }

        .section-intro {
            margin-bottom: 5mm;
        }

        .focus-row {
            grid-template-columns: 8mm 1.5fr 1fr auto;
            padding: 2.5mm 0;
        }

        .case-study,
        .product,
        .experience,
        .capability-row,
        .skill-row {
            break-inside: avoid;
        }

        .case-study {
            padding-bottom: 6mm;
        }

        .case-study + .case-study {
            padding-top: 6mm;
        }

        .my-role {
            padding: 2.5mm 3mm;
        }

        .capability-row {
            grid-template-columns: 42mm 1fr;
            gap: 5mm;
            padding: 3mm 0;
        }

        .product {
            padding: 3mm 0 6mm;
        }

        .product-copy {
            max-width: none;
        }

        .product-secondary {
            display: none;
        }

        .footer {
            margin-top: 8mm;
            padding-top: 3mm;
        }
    }
</style>
