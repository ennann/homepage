---
import { Icon } from "astro-icon/components";
import ResumeLayout from "../../resume/Layout.astro";
import cv from "../../resume/data/cv.json";

const { basics, focus, caseStudies, agentEngineering, independentProductInsight, independentProducts, aiPracticeEvidence, work, skills, recognition, meta } = cv;
const updatedLabel = new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "2-digit"
}).format(new Date(`${meta.updatedAt}T00:00:00+08:00`));
---

<ResumeLayout title={`${basics.name}｜${basics.label}`} description={basics.summary}>
    <main class="resume" id="top">
        <header class="intro" aria-labelledby="resume-name">
            <div class="identity">
                <img
                    class="avatar"
                    src={basics.image}
                    width="88"
                    height="88"
                    alt="赵宜哲的头像"
                    decoding="async"
                    fetchpriority="high"
                />
                <div class="intro-copy">
                    <h1 id="resume-name">{basics.intro[0]}</h1>
                    <p class="intro-lead">{basics.intro[1]}</p>
                    <p>{basics.intro[2]}</p>
                </div>
            </div>

            <nav class="quick-links" aria-label="简历快捷操作">
                <a href="#about"><Icon name="lucide:user-round" class="quick-link-icon" aria-hidden="true" /><span>关于我</span></a>
                <a href={meta.pdfPath} download="赵宜哲-简历.pdf"><Icon name="lucide:file-text" class="quick-link-icon" aria-hidden="true" /><span>下载 PDF</span></a>
                <a href={`mailto:${basics.email}`}><Icon name="lucide:mail" class="quick-link-icon" aria-hidden="true" /><span>{basics.email}</span></a>
                <a href={basics.github} target="_blank" rel="noreferrer"><Icon name="lucide:github" class="quick-link-icon" aria-hidden="true" /><span>GitHub</span></a>
            </nav>
        </header>

        <section class="section" id="about" aria-labelledby="focus-title">
            <p class="section-kicker">关于我</p>
            <h2 id="focus-title">我主要在做四件事</h2>
            <div class="focus-list">
                {focus.map((item) => (
                    <a class="focus-row" href={`#${item.anchor}`}>
                        <span class="focus-number">{item.number}</span>
                        <span class="focus-title">{item.title}</span>
                        <span class="focus-name">{item.name}</span>
                        <span class="focus-result">{item.result}</span>
                    </a>
                ))}
            </div>
        </section>

        <section class="section" aria-labelledby="enterprise-title">
            <p class="section-kicker">客户现场</p>
            <h2 id="enterprise-title">两个独立的消费行业项目</h2>
            <p class="section-intro">
                一个项目解决规模化协作，另一个项目解决 AI 判断与经营闭环。它们共同说明了我如何从现场问题出发，完成产品抽象并推动结果落地。
            </p>

            <div class="case-list">
                {caseStudies.map((project, index) => (
                    <article class="case-study" id={project.id}>
                        <p class="project-index">{String(index + 1).padStart(2, "0")} / {project.eyebrow}</p>
                        <h3>{project.name}</h3>
                        <p class="project-lead">{project.lead}</p>
                        <div class="story">
                            {project.story.map((part) => (
                                <p><strong>{part.label}</strong><span>{part.text}</span></p>
                            ))}
                        </div>
                        <p class="my-role"><strong>我的角色</strong>{project.role}</p>
                        <div class="project-insight">
                            <p class="insight-label">Agent 判断</p>
                            <p>{project.agentInsight}</p>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <section class="section" id={agentEngineering.id} aria-labelledby="agent-title">
            <p class="section-kicker">{agentEngineering.eyebrow}</p>
            <h2 id="agent-title">{agentEngineering.name}</h2>
            <p class="section-intro">{agentEngineering.intro}</p>

            <dl class="capability-list">
                {agentEngineering.items.map((item, index) => (
                    <div class="capability-row">
                        <dt><span>{String(index + 1).padStart(2, "0")}</span>{item.name}</dt>
                        <dd>{item.text}</dd>
                    </div>
                ))}
            </dl>
            <p class="section-conclusion">{agentEngineering.conclusion}</p>
        </section>

        <section class="section" id="indie-products" aria-labelledby="products-title">
            <p class="section-kicker">自己做产品</p>
            <h2 id="products-title">从想法到真实用户</h2>
            <p class="section-intro">
                独立产品让我持续面对真实选择：什么值得做、怎样快速上线、数据说明了什么，以及一个产品如何被长期维护。
            </p>
            <div class="project-insight product-insight">
                <p class="insight-label">人与 Agent</p>
                <p>{independentProductInsight}</p>
            </div>

            <div class="product-list">
                {independentProducts.map((product, index) => (
                    <article class:list={["product", index > 0 && "product-secondary"]} id={product.id}>
                        <a class="product-image-link" href={product.url} target="_blank" rel="noreferrer" aria-label={`查看 ${product.name}`}>
                            <img
                                class="product-image"
                                src={product.image}
                                width={product.imageWidth}
                                height={product.imageHeight}
                                alt={`${product.name} 产品界面`}
                                loading={index === 0 ? "eager" : "lazy"}
                                decoding="async"
                            />
                        </a>
                        <div class="product-summary">
                            <p class="project-index">{String(index + 1).padStart(2, "0")} / 独立产品</p>
                            <h3>{product.name}</h3>
                            <p class="product-label">{product.label}</p>
                        </div>
                        <div class="product-detail">
                            <p>{product.text}</p>
                            <div class="product-footer">
                                <p class="product-metrics">{product.metrics}</p>
                                <a class="text-link" href={product.url} target="_blank" rel="noreferrer">查看产品</a>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <section class="section ai-evidence" id="ai-evidence" aria-labelledby="ai-evidence-title">
            <p class="section-kicker">持续实践</p>
            <h2 id="ai-evidence-title">{aiPracticeEvidence.title}</h2>
            <p class="section-intro">{aiPracticeEvidence.intro}</p>

            <div class="evidence-list">
                {aiPracticeEvidence.items.map((item) => (
                    <a class="evidence-link" href={item.url} target="_blank" rel="noreferrer">
                        <span class="evidence-icon" aria-hidden="true"><Icon name={item.icon} /></span>
                        <span class="evidence-copy">
                            <span class="evidence-kicker">{item.eyebrow}</span>
                            <strong>{item.name}</strong>
                            <span>{item.description}</span>
                        </span>
                        <span class="evidence-action" aria-hidden="true">
                            <span>查看网页</span>
                            <Icon name="lucide:arrow-up-right" />
                        </span>
                    </a>
                ))}
            </div>
        </section>

        <section class="section" id="experience" aria-labelledby="experience-title">
            <p class="section-kicker">工作经历</p>
            <h2 id="experience-title">连接业务产品与工程</h2>

            {work.map((item) => (
                <article class="experience">
                    <div class="experience-heading">
                        <div>
                            <h3>{item.name}</h3>
                            <p>{item.position}</p>
                        </div>
                        <p class="experience-time">2021.07 - 至今</p>
                    </div>
                    <p>{item.summary}</p>
                    <ul>
                        {item.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                </article>
            ))}
        </section>

        <section class="section" id="skills" aria-labelledby="skills-title">
            <p class="section-kicker">能力结构</p>
            <h2 id="skills-title">连接现场与工程</h2>
            <div class="skills-list">
                {skills.map((group) => (
                    <div class="skill-row">
                        <h3>{group.name}</h3>
                        <p>{group.keywords.join(" · ")}</p>
                    </div>
                ))}
            </div>

            <div class="recognition">
                <p><strong>{recognition.title}</strong><span>{recognition.text}</span></p>
            </div>
        </section>

        <section class="closing" aria-labelledby="closing-title">
            <p class="section-kicker">接下来</p>
            <h2 id="closing-title">让 AI 真正成为企业生产力</h2>
            <p>
                接下来，我希望继续站在业务现场与技术之间，从 0 到 1 把模型能力转化为真正进入企业流程的产品：让 Agent 能理解业务、调用工具、遵守边界，并以可衡量的效率提升和业务结果证明价值。
            </p>
            <a class="text-link" href={`mailto:${basics.email}`}>联系我</a>
        </section>

        <footer class="footer">
            <span>{basics.englishName}</span>
            <span>{basics.location.city}</span>
            <span>更新于 {updatedLabel}</span>
            <a href="#top">回到顶部</a>
        </footer>
    </main>
</ResumeLayout>

<style>
    .resume {
        width: min(780px, calc(100% - 48px));
        margin: 0 auto;
        padding: 76px 0 48px;
    }

    .intro {
        margin-bottom: 76px;
    }

    .identity {
        display: grid;
        grid-template-columns: 88px minmax(0, 1fr);
        gap: 32px;
        align-items: start;
    }

    .avatar {
        display: block;
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: var(--soft);
        object-fit: cover;
    }

    .intro-copy {
        max-width: 650px;
    }

    h1,
    h2,
    h3,
    p {
        margin-top: 0;
    }

    h1,
    h2,
    h3 {
        line-break: strict;
        text-wrap: balance;
    }

    h1 {
        margin-bottom: 12px;
        font-size: 22px;
        font-weight: 500;
        letter-spacing: 0;
    }

    h2 {
        margin-bottom: 14px;
        font-size: 20px;
        font-weight: 500;
        line-height: 1.45;
        letter-spacing: 0;
    }

    h3 {
        margin-bottom: 12px;
        font-size: 18px;
        font-weight: 500;
        line-height: 1.45;
        letter-spacing: 0;
    }

    p,
    li,
    dd,
    dt {
        color: var(--body);
        font-size: 16px;
        line-height: 1.68;
        line-break: strict;
        text-wrap: pretty;
        word-break: normal;
    }

    .intro-copy p {
        margin-bottom: 8px;
        font-size: 17px;
        line-height: 1.7;
    }

    .intro-copy .intro-lead {
        color: var(--ink);
        font-weight: 500;
    }

    .quick-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
        margin: 26px 0 0 120px;
        color: var(--body);
        font-size: 14px;
    }

    .quick-links a {
        display: inline-flex;
        gap: 6px;
        align-items: center;
        white-space: nowrap;
        text-decoration: none;
    }

    .quick-link-icon {
        width: 15px;
        height: 15px;
        flex: 0 0 auto;
        color: var(--muted);
        stroke-width: 1.8;
        transition: color 160ms ease;
    }

    .quick-links a span,
    .text-link,
    .footer a {
        text-decoration-line: underline;
        text-decoration-color: #b8b7b0;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
        transition: color 160ms ease, text-decoration-color 160ms ease;
    }

    .quick-links a:hover,
    .text-link:hover,
    .footer a:hover {
        color: var(--accent);
    }

    .quick-links a:hover .quick-link-icon {
        color: var(--accent);
    }

    .quick-links a:hover span,
    .text-link:hover,
    .footer a:hover {
        text-decoration-color: var(--accent);
    }

    .section {
        margin-bottom: 86px;
        scroll-margin-top: 28px;
    }

    .section-kicker,
    .project-index {
        margin-bottom: 8px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 500;
        line-height: 1.5;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .section-intro {
        max-width: 700px;
        margin-bottom: 30px;
    }

    .focus-list {
        margin-top: 24px;
        border-top: 1px solid var(--hairline);
    }

    .focus-row {
        display: grid;
        grid-template-columns: 34px minmax(0, 3fr) minmax(0, 1.5fr) 140px;
        gap: 14px;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid var(--hairline);
        color: var(--body);
        text-decoration: none;
    }

    .focus-row:hover .focus-title {
        color: var(--accent);
    }

    .focus-number,
    .focus-result {
        color: var(--muted);
        font-size: 12px;
        font-variant-numeric: tabular-nums;
    }

    .focus-title {
        color: var(--ink);
        font-size: 14px;
        font-weight: 500;
    }

    .focus-name,
    .focus-result {
        font-size: 13px;
        text-align: left;
    }

    .case-list {
        margin-top: 36px;
    }

    .case-study {
        padding: 0 0 42px;
        scroll-margin-top: 28px;
    }

    .case-study + .case-study {
        padding-top: 42px;
        border-top: 1px solid var(--hairline);
    }

    .project-lead {
        max-width: 690px;
        margin-bottom: 22px;
        color: var(--ink);
        font-size: 16px;
        font-weight: 500;
        line-height: 1.75;
    }

    .story p {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr);
        gap: 10px;
        margin-bottom: 10px;
    }

    .story strong {
        color: var(--ink);
        font-weight: 500;
    }

    .story span {
        min-width: 0;
    }

    .my-role {
        margin: 20px 0 0;
        padding: 0;
        background: transparent;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.65;
    }

    .my-role strong {
        margin-right: 10px;
        color: var(--body);
        font-weight: 500;
    }

    .project-insight {
        display: grid;
        grid-template-columns: 92px minmax(0, 1fr);
        gap: 16px;
        margin: 12px 0 0;
        padding: 14px 16px;
        border-radius: 4px;
        background: var(--soft);
    }

    .project-insight p {
        margin: 0;
        color: var(--body);
        font-size: 13px;
        line-height: 1.7;
    }

    .project-insight .insight-label {
        color: var(--ink);
        font-weight: 500;
    }

    .product-insight {
        margin: -10px 0 8px;
    }

    .capability-list {
        margin: 30px 0 0;
        border-top: 1px solid var(--hairline);
    }

    .capability-row {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 28px;
        padding: 20px 0;
        border-bottom: 1px solid var(--hairline);
    }

    .capability-row dt,
    .capability-row dd {
        margin: 0;
    }

    .capability-row dt {
        color: var(--ink);
        font-size: 14px;
        font-weight: 500;
    }

    .capability-row dt span {
        display: inline-block;
        width: 34px;
        color: var(--muted);
        font-size: 11px;
        font-variant-numeric: tabular-nums;
    }

    .capability-row dd {
        font-size: 14px;
        line-height: 1.75;
    }

    .section-conclusion {
        margin: 22px 0 0;
        color: var(--ink);
        font-weight: 500;
    }

    .product {
        display: grid;
        grid-template-columns: 20% minmax(0, 1fr);
        column-gap: 30px;
        row-gap: 22px;
        align-items: start;
        padding: 30px 0 44px;
        scroll-margin-top: 28px;
    }

    .product + .product {
        border-top: 1px solid var(--hairline);
    }

    .product-image-link {
        display: grid;
        overflow: hidden;
        place-items: center;
        width: 100%;
        aspect-ratio: 4 / 3;
        border: 1px solid var(--hairline);
        border-radius: 8px;
        background: var(--soft);
        transition: border-color 180ms ease;
    }

    .product-image {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
        border-radius: 6px;
        background: transparent;
        object-fit: contain;
        object-position: center;
        transition: transform 180ms ease;
    }

    .product-image-link:hover {
        border-color: #cbc8bd;
    }

    .product-image-link:hover .product-image {
        transform: scale(1.015);
    }

    .product-summary {
        align-self: center;
        min-width: 0;
    }

    .product-summary h3 {
        margin-bottom: 7px;
    }

    .product-summary .project-index,
    .product-summary .product-label,
    .product-detail p {
        margin-top: 0;
    }

    .product-detail {
        display: grid;
        grid-column: 1 / 3;
        gap: 14px;
        width: 100%;
        min-width: 0;
    }

    .product-detail > p {
        max-width: 740px;
        margin-bottom: 0;
    }

    .product-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 22px;
        align-items: baseline;
        justify-content: space-between;
    }

    .product-footer .text-link {
        margin-top: 0;
    }

    .product-label {
        color: var(--muted);
        font-size: 13px;
    }

    .product-metrics {
        color: var(--ink);
        font-size: 13px;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
    }

    .text-link {
        display: inline-block;
        margin-top: 5px;
        color: var(--ink);
        font-size: 14px;
        font-weight: 500;
    }

    .evidence-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border-top: 1px solid var(--hairline);
        border-bottom: 1px solid var(--hairline);
    }

    .evidence-link {
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr) auto;
        gap: 14px;
        align-items: start;
        padding: 22px 28px 22px 0;
        color: var(--body);
        text-decoration: none;
    }

    .evidence-link + .evidence-link {
        padding-right: 0;
        padding-left: 28px;
        border-left: 1px solid var(--hairline);
    }

    .evidence-icon {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: var(--brand-tint);
        color: var(--accent);
    }

    .evidence-icon :global(svg) {
        width: 17px;
        height: 17px;
        stroke-width: 1.7;
    }

    .evidence-copy {
        display: grid;
        gap: 5px;
        min-width: 0;
    }

    .evidence-copy strong {
        color: var(--ink);
        font-size: 16px;
        font-weight: 500;
        line-height: 1.5;
    }

    .evidence-copy > span:last-child {
        font-size: 13px;
        line-height: 1.7;
    }

    .evidence-kicker {
        color: var(--muted);
        font-size: 11px;
        line-height: 1.4;
    }

    .evidence-action {
        display: inline-flex;
        gap: 4px;
        align-items: center;
        padding-top: 22px;
        color: var(--muted);
        font-size: 12px;
        white-space: nowrap;
        transition: color 160ms ease;
    }

    .evidence-action :global(svg) {
        width: 13px;
        height: 13px;
    }

    .evidence-link:hover .evidence-copy strong,
    .evidence-link:hover .evidence-action {
        color: var(--accent);
    }

    .experience {
        padding-top: 28px;
        border-top: 1px solid var(--hairline);
    }

    .experience-heading {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 20px;
    }

    .experience-heading h3,
    .experience-heading p {
        margin-bottom: 2px;
    }

    .experience-time {
        color: var(--muted);
        font-size: 13px;
        white-space: nowrap;
    }

    .experience ul {
        margin: 20px 0 0;
        padding: 0;
        list-style: none;
    }

    .experience li {
        position: relative;
        margin-bottom: 8px;
        padding-left: 18px;
    }

    .experience li::before {
        position: absolute;
        left: 0;
        color: var(--muted);
        content: "-";
    }

    .skills-list {
        margin-top: 28px;
        border-top: 1px solid var(--hairline);
    }

    .skill-row {
        display: grid;
        grid-template-columns: 140px minmax(0, 1fr);
        gap: 24px;
        padding: 17px 0;
        border-bottom: 1px solid var(--hairline);
    }

    .skill-row h3,
    .skill-row p {
        margin: 0;
        font-size: 14px;
        line-height: 1.75;
    }

    .skill-row h3 {
        color: var(--ink);
    }

    .recognition {
        margin-top: 28px;
        padding: 18px 0;
    }

    .recognition p {
        display: flex;
        gap: 14px;
        margin: 0;
    }

    .recognition strong {
        flex: 0 0 auto;
        color: var(--ink);
    }

    .closing {
        margin: 8px 0 90px;
        padding: 34px 0 0;
        border-top: 1px solid var(--hairline);
    }

    .closing h2 {
        max-width: 660px;
        font-size: 24px;
    }

    .closing p:not(.section-kicker) {
        max-width: 690px;
    }

    .footer {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 18px;
        align-items: center;
        padding-top: 22px;
        border-top: 1px solid var(--hairline);
        color: var(--muted);
        font-size: 12px;
    }

    .footer a {
        margin-left: auto;
    }

    @media (max-width: 720px) {
        .resume {
            width: min(100% - 36px, 780px);
            padding-top: 66px;
        }

        .identity {
            grid-template-columns: 64px minmax(0, 1fr);
            gap: 18px;
        }

        .avatar {
            width: 64px;
            height: 64px;
        }

        .intro-copy p {
            font-size: 16px;
        }

        .quick-links {
            margin-left: 82px;
        }

        .intro,
        .section {
            margin-bottom: 64px;
        }

        .focus-row {
            grid-template-columns: 30px minmax(0, 1fr);
            gap: 8px;
        }

        .focus-name,
        .focus-result {
            grid-column: 2;
        }

        .focus-result {
            margin-top: -5px;
